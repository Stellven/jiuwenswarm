#!/bin/sh
# ai4r-bench: one entry command for the ccbench harnesses (benchmarks/ccbench).
#
#   ai4r-bench <bench> [script] [args] --out DIR     run one bench; every output goes to DIR
#   ai4r-bench selftest [bench ...]                  run the self-tests (all benches by default)
#   ai4r-bench list                                  show benches and their scripts
#   ai4r-bench build-native [--yes] --out DIR        build the native opponent image ai4r:ccbench-native (prints the command without --yes)
#
# Add --host anywhere to run on the host Python instead of the container. Use --host for the model runs
# (planner run, planbench run) if the container cannot reach your codex login, and always for nativetask,
# which starts its own docker containers (docker inside docker is not supported; it is forced to --host).
#
# Default: inside docker image $AI4R_BENCH_IMAGE (default ai4r:cc-v1-baseline), with this repo mounted read-only
# at /opt/ai4r (so a bench cannot write into its source), DIR mounted at /out, and the old evidence root
# (AI4R_BENCH_DATA, default ~/huawei/outputs/cc-sweep-20261026) mounted read-only at /data when it exists.
#
# Environment
#   AI4R_BENCH_IMAGE   image to run in (default ai4r:cc-v1-baseline)
#   AI4R_BENCH_DATA    old evidence root: traps/ for trapcheck, stored baselines
#   AI4R_CODEX_HOME    your codex config dir (holds the login); mounted at ~/.codex in the container for model runs
#   AI4R_CODEX_BIN     codex executable for --host runs (default: codex on PATH)
#   AI4R_PYTHON        host interpreter for --host (default: python3, else python)
#
# Benches (the first script is the default; the next word may name another one):
#   admission    study | verify_study | build_candidates            (study: --reps N)
#   gatebench    run | freeze | verify | model_stream                (run: --seeds N)
#   trapcheck    run                                                 (needs AI4R_BENCH_DATA/traps)
#   planner      run_planner_bench plan|run|score | generate_tasks   (run: --task ID, repeatable)
#   nativeadmit  cc_route | cc_fallback | score | build_items
#   nativetask   run_native_task plan|run|collect|init-ledger        (host only)
#   planbench    run_arm run|score | generate_tasks | generate_skillpack | freeze
#   cclib        verify | compare_prompts
set -eu

die() { echo "ai4r-bench: $*" >&2; exit 2; }

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/.." && { pwd -W 2>/dev/null || pwd; })
image=${AI4R_BENCH_IMAGE:-ai4r:cc-v1-baseline}
data=${AI4R_BENCH_DATA:-$HOME/huawei/outputs/cc-sweep-20261026}

scripts_of() {
    case $1 in
        admission) echo "study verify_study build_candidates" ;;
        gatebench) echo "run freeze verify model_stream" ;;
        trapcheck) echo "run" ;;
        planner) echo "run_planner_bench generate_tasks" ;;
        nativeadmit) echo "cc_route cc_fallback score build_items" ;;
        nativetask) echo "run_native_task" ;;
        planbench) echo "run_arm generate_tasks generate_skillpack freeze" ;;
        cclib) echo "verify compare_prompts" ;;
        *) return 1 ;;
    esac
}

if [ $# -lt 1 ]; then sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 2; fi
cmd=$1; shift

if [ "$cmd" = list ]; then
    for b in admission gatebench trapcheck planner nativeadmit nativetask planbench cclib; do
        echo "$b: $(scripts_of $b)"
    done
    exit 0
fi

# Split off --host and --out DIR; keep the rest in order.
host=0; out=''
n=$#; i=0
while [ $i -lt $n ]; do
    a=$1; shift; i=$((i + 1))
    case $a in
        --host) host=1 ;;
        --out) [ $# -ge 1 ] || die "--out needs a directory"; out=$1; shift; i=$((i + 1)) ;;
        --out=*) out=${a#--out=} ;;
        *) set -- "$@" "$a" ;;
    esac
done

if [ "$cmd" = build-native ]; then
    # Build the plain native JiuwenSwarm image used as the native opponent (nativetask --image ai4r:ccbench-native).
    # No recipe was stored for the sweep's ai4r:cc-value-medium-20261026; this is the documented M1 production build
    # (deploy/m1/Dockerfile.app, target production) of THIS checkout. It needs network (base images, uv sync, npm ci) and
    # several GB of RAM and disk, so it only runs with --yes; without it the command is printed.
    tag=${AI4R_NATIVE_TAG:-ai4r:ccbench-native}
    build="docker build --platform linux/amd64 -f deploy/m1/Dockerfile.app --target production -t $tag ."
    if [ "${1:-}" != --yes ]; then
        echo "would run in $repo:"; echo "  $build"; echo "then write native-image.json (tag, id, repo digests, git commit) to --out. Add --yes to run."
        exit 0
    fi
    [ -n "$out" ] || die "build-native needs --out DIR for native-image.json"
    mkdir -p "$out"
    (cd "$repo" && $build)
    commit=$(cd "$repo" && git rev-parse HEAD 2>/dev/null || echo unknown)
    id=$(docker image inspect "$tag" --format '{{.Id}}')
    digests=$(docker image inspect "$tag" --format '{{json .RepoDigests}}')
    printf '{"tag": "%s", "id": "%s", "repo_digests": %s, "git_commit": "%s", "dockerfile": "deploy/m1/Dockerfile.app", "target": "production"}
' "$tag" "$id" "$digests" "$commit" > "$out/native-image.json"
    cat "$out/native-image.json"
    exit 0
fi

bench_dir=''
script=''
if [ "$cmd" != selftest ]; then
    scripts_of "$cmd" >/dev/null || die "unknown bench '$cmd' (try: ai4r-bench list)"
    script=$(scripts_of "$cmd" | cut -d' ' -f1)
    if [ $# -ge 1 ]; then
        for s in $(scripts_of "$cmd"); do
            if [ "$1" = "$s" ] || { [ "$cmd" = admission ] && [ "$1" = verify ] && [ "$s" = verify_study ]; }; then
                script=$s; shift; break
            fi
        done
    fi
    script=$script.py
    bench_dir=$cmd
    [ -n "$out" ] || die "$cmd needs --out DIR (every output is written there)"
fi
if [ "$cmd" = nativetask ]; then host=1; fi

out_abs=''
if [ -n "$out" ]; then
    mkdir -p "$out"
    out_abs=$(CDPATH= cd -- "$out" && { pwd -W 2>/dev/null || pwd; })
fi

if [ $host -eq 1 ]; then
    py=${AI4R_PYTHON:-}
    if [ -z "$py" ]; then
        if python3 -c 'import sys' >/dev/null 2>&1; then py=python3; else py=python; fi
    fi
    export AI4R_CODE_ROOT=$repo PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 AI4R_BENCH_DATA=$data
    export PYTHONPATH="$repo${PYTHONPATH:+:$PYTHONPATH}"
    if [ "$cmd" = selftest ]; then
        exec "$py" -B "$repo/benchmarks/ccbench/selftest.py" "$@"
    fi
    # cwd is the output directory: libraries that log into the cwd (openjiuwen) then write there, not into the repo.
    cd "$out_abs"
    exec "$py" -B "$repo/benchmarks/ccbench/$bench_dir/$script" "$@" --out "$out_abs"
fi

command -v docker >/dev/null 2>&1 || die "docker not found; install it or add --host"
docker image inspect "$image" >/dev/null 2>&1 || die "image $image not found; set AI4R_BENCH_IMAGE or add --host"

# Git Bash on Windows would rewrite /opt/... arguments; the container paths below are literal.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
set -- "$@" # keep the bench arguments as-is
mounts="-v $repo:/opt/ai4r:ro"
if [ -d "$data" ]; then
    data_abs=$(CDPATH= cd -- "$data" && { pwd -W 2>/dev/null || pwd; })
    mounts="$mounts -v $data_abs:/data:ro"
fi
if [ -n "$out_abs" ]; then mounts="$mounts -v $out_abs:/out"; fi
if [ -n "${AI4R_CODEX_HOME:-}" ]; then mounts="$mounts -v $AI4R_CODEX_HOME:/tmp/home/.codex"; fi
user=''
if command -v id >/dev/null 2>&1; then user="--user $(id -u):$(id -g)"; fi

common="-e HOME=/tmp/home -e AI4R_CODE_ROOT=/opt/ai4r -e AI4R_BENCH_DATA=/data -e PYTHONPATH=/opt/ai4r -e PYTHONDONTWRITEBYTECODE=1 -e PYTHONIOENCODING=utf-8"
if [ "$cmd" = selftest ]; then
    # shellcheck disable=SC2086
    exec docker run --rm $user $mounts -w /tmp $common \
        --entrypoint /opt/venv/bin/python "$image" -B /opt/ai4r/benchmarks/ccbench/selftest.py "$@"
fi
# shellcheck disable=SC2086
exec docker run --rm $user $mounts -w /out $common \
    --entrypoint /opt/venv/bin/python "$image" -B "/opt/ai4r/benchmarks/ccbench/$bench_dir/$script" "$@" --out /out
