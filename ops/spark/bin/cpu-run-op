#!/usr/bin/env python3
"""Pass through only a CPU/build job owned by the private Spark queue."""
import json
import os
from pathlib import Path
import sys

job_id = os.environ.get('JOBQ_JOB_ID', '')
if not job_id.startswith('job-') or any(c not in 'job-0123456789abcdef' for c in job_id):
    sys.exit('Invalid queue job identity')
root = (Path.home() / 'predemo-spark/OPS/jobq-cpu').resolve()
if os.environ.get('SPARK_OWNER_BUILD') == 'placement-tier':
    root = root.with_name('jobq-cpu-c2')
if Path(os.environ.get('JOBQ_DIR', '')).resolve() != root:
    sys.exit('Only the private Spark CPU queue is allowed')
job = json.loads((root / (job_id + '.json')).read_text())
if job['class'] not in {'build', 'cpu'}:
    sys.exit('GPU jobs are forbidden in the Spark CPU worker')
args = sys.argv[1:]
if '--' not in args:
    sys.exit('Missing command separator')
command = args[args.index('--') + 1:]
if not command:
    sys.exit('Missing command')
os.execv(command[0], command)
