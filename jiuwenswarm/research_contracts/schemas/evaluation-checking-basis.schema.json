{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:evaluation-checking-basis:1",
  "title": "evaluation-checking-basis",
  "x-owning-interface": "M1-IF-016@r1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai4r-evaluation-checking-basis:1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request_ref": {
      "$ref": "#/$defs/Ref"
    },
    "node_context_ref": {
      "$ref": "#/$defs/Ref"
    },
    "assignment_context_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_contract_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_check_plan_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_template_ref": {
      "$ref": "#/$defs/Ref"
    },
    "mode": {
      "enum": [
        "replay_subject",
        "worker_output",
        "verifier_output"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      }
    },
    "profile_ref": {
      "$ref": "#/$defs/Ref"
    },
    "policy_ref": {
      "$ref": "#/$defs/Ref"
    },
    "mandatory_deterministic": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "mandatory_semantic": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "maxItems": 32
    },
    "runner_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "output_port": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted": {
      "const": false
    },
    "invalid_for_product": {
      "const": true
    }
  },
  "required": [
    "schema",
    "id",
    "request_ref",
    "node_context_ref",
    "assignment_context_ref",
    "source_contract_ref",
    "source_check_plan_ref",
    "source_template_ref",
    "mode",
    "input_refs",
    "profile_ref",
    "policy_ref",
    "mandatory_deterministic",
    "mandatory_semantic",
    "runner_refs",
    "output_port",
    "accepted",
    "invalid_for_product"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replay_subject"
          }
        }
      },
      "then": {
        "properties": {
          "assignment_context_ref": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "assignment_context_ref": {
            "$ref": "#/$defs/Ref"
          },
          "mandatory_semantic": {
            "const": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "worker_output"
          }
        }
      },
      "then": {
        "properties": {
          "output_port": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "output_port": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Data structure only. The installed M1-002 owner independently validates exact indexed kinds and hashes, durable ownership and provenance joins, approved source pins, uniqueness, authority narrowing, budgets and original deadlines. Shape validation grants no execution or product authority."
}
