{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-helper-session-request:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "target_ref", "fixture_manifest_ref", "session_id", "started_by", "limits", "worker", "hash_profile_ref", "invocation_wall_s", "evidence_wall_s", "frozen_at"],
  "properties": {
    "schema": {"const": "ai4r-rsi-helper-session-request:1"}, "target_ref": {"$ref": "#/$defs/Ref"},
    "fixture_manifest_ref": {"$ref": "#/$defs/Ref"}, "hash_profile_ref": {"$ref": "#/$defs/Ref"},
    "session_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"},
    "started_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "frozen_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "invocation_wall_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "evidence_wall_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
    "limits": {"type": "object", "additionalProperties": false,
      "required": ["max_attempts", "max_no_progress", "wall_s", "per_call_s", "session_query_limit", "lifetime_query_limit"],
      "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 20}, "max_no_progress": {"type": "integer", "minimum": 1, "maximum": 5},
        "wall_s": {"type": "integer", "minimum": 1, "maximum": 3600}, "per_call_s": {"type": "integer", "minimum": 1, "maximum": 300},
        "session_query_limit": {"type": "integer", "minimum": 1, "maximum": 30}, "lifetime_query_limit": {"type": "integer", "minimum": 1, "maximum": 90}}},
    "worker": {"type": "object", "additionalProperties": false,
      "required": ["target_kind", "contract_ref", "environment_ref", "hardware_ref", "memory_mb", "pids_max", "timeout_s", "process_policy"],
      "properties": {"target_kind": {"enum": ["ranking-v1", "normalize-labels-v1"]},
        "contract_ref": {"$ref": "#/$defs/Ref"}, "environment_ref": {"$ref": "#/$defs/Ref"}, "hardware_ref": {"$ref": "#/$defs/Ref"},
        "memory_mb": {"type": "integer", "minimum": 1, "maximum": 65536}, "pids_max": {"type": "integer", "minimum": 1, "maximum": 256},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}, "process_policy": {"const": "single_process_seccomp_v1"}}}
  },
  "$defs": {"Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
