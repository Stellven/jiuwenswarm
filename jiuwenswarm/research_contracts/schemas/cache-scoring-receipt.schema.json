{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:cache-scoring-receipt:1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai4r-cache-scoring-receipt:1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "baseline",
        "treatment"
      ]
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "subject_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "validation_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "prediction_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "execution_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_data_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scorer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "scored",
        "unmeasured"
      ]
    },
    "failure_reason": {
      "enum": [
        null,
        "execution_failed",
        "observation_invalid"
      ]
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "metrics": {
      "type": "object",
      "properties": {
        "miss_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit": {
      "const": "requests"
    },
    "miss_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "observations": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hits": {
                "type": "integer",
                "minimum": 0
              },
              "misses": {
                "type": "integer",
                "minimum": 0
              },
              "unbounded_misses": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "hits",
              "misses",
              "unbounded_misses"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "run_id",
    "node_id",
    "attempt_id",
    "contract_ref",
    "invocation_id",
    "job_id",
    "sequence",
    "role",
    "repeat_index",
    "seed",
    "subject_ref",
    "validation_ref",
    "prediction_ref",
    "execution_identity_sha256",
    "public_data_sha256",
    "scorer_sha256",
    "status",
    "failure_reason",
    "sample_count",
    "metrics",
    "protocol_sha256",
    "source_id",
    "unit",
    "miss_count",
    "observations"
  ],
  "additionalProperties": false
}
