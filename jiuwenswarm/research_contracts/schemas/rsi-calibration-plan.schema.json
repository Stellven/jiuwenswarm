{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-calibration-plan:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "preparation_ref", "review_ref", "target_ref", "fixture_manifest_ref", "session_ref", "worker_profile_ref", "collector_ref", "target_context_sha256", "fixture_context_sha256", "fixture_identity", "pass_count_repeats", "invocation_wall_s", "evidence_wall_s", "wall_s", "reserved_wall_s", "expected_invocations"],
  "properties": {
    "schema": {"const": "ai4r-rsi-calibration-plan:1"},
    "preparation_ref": {"$ref": "#/$defs/Ref"}, "review_ref": {"$ref": "#/$defs/Ref"},
    "target_ref": {"$ref": "#/$defs/Ref"}, "fixture_manifest_ref": {"$ref": "#/$defs/Ref"},
    "session_ref": {"$ref": "#/$defs/Ref"}, "worker_profile_ref": {"$ref": "#/$defs/Ref"},
    "collector_ref": {"$ref": "#/$defs/Ref"},
    "target_context_sha256": {"$ref": "#/$defs/Digest"}, "fixture_context_sha256": {"$ref": "#/$defs/Digest"},
    "fixture_identity": {"type": "string", "minLength": 1}, "pass_count_repeats": {"enum": [1, 3]},
    "invocation_wall_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "evidence_wall_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
    "wall_s": {"type": "integer", "minimum": 1, "maximum": 3600},
    "reserved_wall_s": {"type": "integer", "minimum": 1, "maximum": 3600},
    "expected_invocations": {"type": "integer", "minimum": 1, "maximum": 100000}
  },
  "$defs": {
    "Digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/Digest"}}}
  }
}
