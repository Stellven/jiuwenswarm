{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-session-job:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "session_ref", "preparation_ref", "diagnosis_contract_ref", "visible_context_ref", "proposer_contract_refs", "worker_profile_ref", "fixture_identity", "target_kind"],
  "properties": {
    "schema": {"const": "ai4r-rsi-session-job:2"},
    "session_ref": {"$ref": "#/$defs/Ref"}, "preparation_ref": {"$ref": "#/$defs/Ref"},
    "diagnosis_contract_ref": {"$ref": "#/$defs/Ref"}, "visible_context_ref": {"$ref": "#/$defs/Ref"},
    "proposer_contract_refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/Ref"}},
    "worker_profile_ref": {"$ref": "#/$defs/Ref"}, "fixture_identity": {"type": "string", "minLength": 1},
    "target_kind": {"enum": ["ranking-v1", "normalize-labels-v1", "screening-text-v1"]}
  },
  "$defs": {"Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"],
    "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
