{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ai4r:private:rsi-candidate-binding:1",
  "description":"Protected exact helper-body/declaration join. This record conveys no security qualification, admission or execution authority.",
  "type":"object","additionalProperties":false,
  "required":["schema","session_ref","candidate_ref","declaration_ref","target_ref","parent_declaration_ref","body_path"],
  "properties":{
    "schema":{"const":"ai4r-rsi-candidate-binding:1"},
    "session_ref":{"$ref":"#/$defs/Ref"},"candidate_ref":{"$ref":"#/$defs/Ref"},
    "declaration_ref":{"$ref":"#/$defs/Ref"},"target_ref":{"$ref":"#/$defs/Ref"},
    "parent_declaration_ref":{"$ref":"#/$defs/Ref"},"body_path":{"type":"string","minLength":1}
  },
  "$defs":{"Ref":{"type":"object","additionalProperties":false,"required":["id","sha256"],"properties":{
    "id":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }}}
}
