{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-fixture-capture:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "session_ref", "candidate_ref", "fixture_id", "phase", "receipt", "timing", "batch_iterations", "program_sha256", "worker_profile_ref", "input_ref", "reservation_ref", "repeat_index"],
  "properties": {
    "schema": {"const": "ai4r-rsi-fixture-capture:2"},
    "session_ref": {"$ref": "#/$defs/Ref"}, "candidate_ref": {"$ref": "#/$defs/Ref"},
    "fixture_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["development", "platform", "hidden_loop", "hidden_final"]},
    "receipt": {"type": "object"}, "timing": {"type": "boolean"},
    "batch_iterations": {"type": "integer", "minimum": 1},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_profile_ref": {"$ref": "#/$defs/Ref"}, "input_ref": {"$ref": "#/$defs/Ref"},
    "reservation_ref": {"$ref": "#/$defs/Ref"}, "repeat_index": {"type": "integer", "minimum": 0, "maximum": 2}
  },
  "$defs": {"Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"],
    "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
