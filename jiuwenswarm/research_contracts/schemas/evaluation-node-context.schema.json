{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:evaluation-node-context:1",
  "title": "evaluation-node-context",
  "x-owning-interface": "M1-IF-016@r1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai4r-evaluation-node-context:1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_binding_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_contract_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_node_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_template_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_check_plan_ref": {
      "$ref": "#/$defs/Ref"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "const": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoundNodeInput"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoundNodeOutput"
      },
      "minItems": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "node_limits": {
      "$ref": "#/$defs/Limits"
    },
    "authority_ceiling": {
      "$ref": "#/$defs/AuthorityCeiling"
    },
    "subnodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodeSubnodeAssignment"
      }
    },
    "checking_profile_ref": {
      "$ref": "#/$defs/Ref"
    },
    "policy_ref": {
      "$ref": "#/$defs/Ref"
    },
    "configuration_ref": {
      "$ref": "#/$defs/Ref"
    },
    "started_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "deadline_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "accepted": {
      "const": false
    },
    "invalid_for_product": {
      "const": true
    }
  },
  "required": [
    "schema",
    "id",
    "request_ref",
    "source_binding_ref",
    "source_contract_ref",
    "source_node_ref",
    "source_template_ref",
    "source_check_plan_ref",
    "run_id",
    "node_id",
    "attempt_id",
    "revision",
    "objective",
    "requirement_ids",
    "inputs",
    "outputs",
    "input_refs",
    "required_outputs",
    "evidence_obligations",
    "node_limits",
    "authority_ceiling",
    "subnodes",
    "checking_profile_ref",
    "policy_ref",
    "configuration_ref",
    "started_unix_ns",
    "deadline_unix_ns",
    "accepted",
    "invalid_for_product"
  ],
  "additionalProperties": false,
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "time_s",
        "model_calls",
        "memory_mb"
      ],
      "additionalProperties": false
    },
    "AuthorityCeiling": {
      "type": "object",
      "properties": {
        "network": {
          "enum": [
            "none",
            "allowlist"
          ]
        },
        "network_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "resource_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "minItems": 0
        },
        "write_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "network",
        "network_allowlist",
        "resource_reads",
        "write_roots",
        "tools"
      ],
      "additionalProperties": false
    },
    "BoundNodeInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "name",
        "contract_id",
        "version",
        "required",
        "artifact_refs"
      ],
      "additionalProperties": false
    },
    "BoundNodeOutput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "contract_id",
        "version",
        "required"
      ],
      "additionalProperties": false
    },
    "NodeSubnodeAssignment": {
      "type": "object",
      "properties": {
        "subnode_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "work",
            "verifier"
          ]
        },
        "template_ref": {
          "$ref": "#/$defs/Ref"
        },
        "capsule_ref": {
          "$ref": "#/$defs/Ref"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "subnode_id",
        "role",
        "template_ref",
        "capsule_ref",
        "depends_on",
        "required"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Data structure only. The installed M1-002 owner independently validates exact indexed kinds and hashes, durable ownership and provenance joins, approved source pins, uniqueness, authority narrowing, budgets and original deadlines. Shape validation grants no execution or product authority."
}
