{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:node-attempt-inspection-response:1",
  "x-owning-interface": "M1-IF-003@r3",
  "type": "object",
  "properties": {
    "node_contract_ref": {
      "$ref": "#/$defs/Ref"
    },
    "run_plan_ref": {
      "$ref": "#/$defs/Ref"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "terminal",
        "cancelled",
        "outcome_unknown"
      ]
    },
    "dispatch_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_outcome": {
      "enum": [
        "accepted",
        "rejected",
        "halted",
        "failed",
        "budget_exhausted",
        "interrupted",
        null
      ]
    },
    "cancellation_record": {
      "anyOf": [
        {
          "$ref": "urn:jiuwenswarm:m1-design:field-contracts:compiled:1#/$defs/client-cancellation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "node_contract_ref",
    "run_plan_ref",
    "run_id",
    "node_id",
    "attempt_id",
    "state",
    "dispatch_ref",
    "source_outcome",
    "cancellation_record"
  ],
  "additionalProperties": false,
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Registered original typed data only; implementation remains pending/unbuilt. Actual live prepared/active owner, custody kind/hash/joins, deadlines/cancellation, global lease and actual service/kernel evidence are independent mandatory checks; this data grants no authority."
}
