{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:m1-design:empirical-results:2.0.0",
  "title": "M1-IF-005@r1 authorized C002 empirical observations",
  "type": "object",
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "id": {"const": "empirical_results"},
    "runs": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "status": {"enum": ["measured", "partial", "unmeasured"]},
          "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
          "unmeasured_metrics": {
            "type": "object",
            "additionalProperties": {"enum": ["run_failed", "timeout", "metric_not_emitted", "non_finite_value", "resource_limit_exceeded"]}
          }
        },
        "required": ["sequence", "status", "metrics", "unmeasured_metrics"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "id", "runs"],
  "additionalProperties": false
}
