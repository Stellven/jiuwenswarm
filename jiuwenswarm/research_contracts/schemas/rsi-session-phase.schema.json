{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-session-phase:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "session_ref", "revision", "phase", "previous_ref", "incumbent_ref", "attempts_used", "queries_used", "terminal_result_ref", "recorded_at"],
  "properties": {
    "schema": {"const": "ai4r-rsi-session-phase:1"},
    "session_id": {"type": "string", "minLength": 1},
    "session_ref": {"$ref": "#/$defs/Ref"},
    "revision": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["PREFLIGHT", "BASELINE", "SEARCH", "FINALIZING", "CLOSED"]},
    "previous_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Ref"}]},
    "incumbent_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Ref"}]},
    "attempts_used": {"type": "integer", "minimum": 0, "maximum": 20},
    "queries_used": {"type": "integer", "minimum": 0, "maximum": 30},
    "terminal_result_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Ref"}]},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "allOf": [{"if": {"properties": {"phase": {"const": "CLOSED"}}}, "then": {"properties": {"terminal_result_ref": {"$ref": "#/$defs/Ref"}}}, "else": {"properties": {"terminal_result_ref": {"type": "null"}}}}],
  "$defs": {
    "Ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
