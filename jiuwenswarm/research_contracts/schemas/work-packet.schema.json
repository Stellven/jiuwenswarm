{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:work-packet:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data", "files", "trust", "provenance", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "data": {"type": "object", "maxProperties": 64},
    "files": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "text", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 200},
        "text": {"type": "string", "maxLength": 262144},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "trust": {"enum": ["provisional", "low"]},
    "provenance": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {
      "type": "object", "required": ["id", "sha256"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "limitations": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1000}}
  }
}
