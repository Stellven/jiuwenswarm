{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-calibration:2",
  "description": "Acyclic original-byte target/fixture contexts. Version1 signatures retain their historical meaning. Actual protected worker calibration and independent review are required; this schema grants no execution authority.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "target_context_sha256", "fixture_context_sha256", "preparation_ref", "review_ref", "pass_count_repeats", "noise_capture_refs", "control_refs", "known_bad_rejected", "known_good_qualified", "measurable_headroom", "evidence_refs", "signer_key_id", "signature"],
  "properties": {
    "schema": {"const": "ai4r-rsi-calibration:2"},
    "target_context_sha256": {"$ref": "#/$defs/Digest"},
    "fixture_context_sha256": {"$ref": "#/$defs/Digest"},
    "preparation_ref": {"$ref": "#/$defs/Ref"}, "review_ref": {"$ref": "#/$defs/Ref"},
    "pass_count_repeats": {"enum": [1, 3]},
    "noise_capture_refs": {"type": "array", "minItems": 480, "uniqueItems": true, "items": {"$ref": "#/$defs/Ref"}},
    "control_refs": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"$ref": "#/$defs/Ref"}},
    "known_bad_rejected": {"type": "integer", "minimum": 10},
    "known_good_qualified": {"type": "integer", "minimum": 3},
    "measurable_headroom": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Ref"}},
    "signer_key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "Digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/Digest"}}}
  }
}
