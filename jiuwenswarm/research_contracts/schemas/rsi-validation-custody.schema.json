{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-validation-custody:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "plan_ref", "scope_ref", "attack_pins_ref", "custodian_key_id", "custodian_public_key", "rpc_session_id", "rpc_capability"],
  "properties": {
    "schema": {"const": "ai4r-rsi-validation-custody:1"},
    "plan_ref": {"$ref": "#/$defs/Ref"}, "scope_ref": {"$ref": "#/$defs/Ref"}, "attack_pins_ref": {"$ref": "#/$defs/Ref"},
    "custodian_key_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"},
    "custodian_public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "rpc_session_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"},
    "rpc_capability": {"type": "string", "minLength": 43, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$defs": {"Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
