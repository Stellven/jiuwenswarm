{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:manual-route-record:2.0.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "route_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "subnode_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "router_enabled": {"const": false},
    "decision_source": {"const": "user_api"},
    "router_failure": {"const": null},
    "router_halt_code": {"const": null},
    "model_id": {"type": "string", "minLength": 1},
    "route_decision_ref": {"const": null},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "required": ["schema_version", "route_id", "run_id", "node_id", "subnode_id", "invocation_id", "router_enabled", "decision_source", "router_failure", "router_halt_code", "model_id", "route_decision_ref", "recorded_at"],
  "additionalProperties": false
}
