{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:evaluation-assignment-grant:1",
  "title": "evaluation-assignment-grant",
  "x-owning-interface": "M1-IF-016@r1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai4r-evaluation-assignment-grant:1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request_ref": {
      "$ref": "#/$defs/Ref"
    },
    "scope_ref": {
      "$ref": "#/$defs/Ref"
    },
    "role": {
      "enum": [
        "worker",
        "verifier"
      ]
    },
    "output_port": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_contract_ref": {
      "$ref": "#/$defs/Ref"
    },
    "contract_ref": {
      "$ref": "#/$defs/Ref"
    },
    "check_plan_ref": {
      "$ref": "#/$defs/Ref"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "started_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "deadline_unix_ns": {
      "type": "integer",
      "minimum": 0
    },
    "accepted": {
      "const": false
    },
    "invalid_for_product": {
      "const": true
    }
  },
  "required": [
    "schema",
    "id",
    "request_ref",
    "scope_ref",
    "role",
    "output_port",
    "source_contract_ref",
    "contract_ref",
    "check_plan_ref",
    "execution_id",
    "invocation_id",
    "limits",
    "started_unix_ns",
    "deadline_unix_ns",
    "accepted",
    "invalid_for_product"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "worker"
          }
        }
      },
      "then": {
        "properties": {
          "output_port": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "output_port": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "time_s",
        "model_calls",
        "memory_mb"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Data structure only. The installed M1-002 owner independently validates exact indexed kinds and hashes, durable ownership and provenance joins, approved source pins, uniqueness, authority narrowing, budgets and original deadlines. Shape validation grants no execution or product authority."
}
