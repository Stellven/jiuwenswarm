{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-validation-evidence:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "plan_ref", "scope_ref", "attack_pins_ref", "case_id", "record_ref", "observation_ref", "case_claim_ref", "originals"],
  "properties": {
    "schema": {"const": "ai4r-rsi-validation-evidence:1"},
    "plan_ref": {"$ref": "#/$defs/Ref"}, "scope_ref": {"$ref": "#/$defs/Ref"}, "attack_pins_ref": {"$ref": "#/$defs/Ref"},
    "case_id": {"enum": [null, "RSIV-1", "RSIV-2", "RSIV-3", "RSIV-4", "RSIV-5", "RSIV-6", "RSIV-7", "RSIV-8", "RSIV-9", "RSIV-10", "RSIV-11", "RSIV-12", "RSIV-13"]},
    "record_ref": {"$ref": "#/$defs/OptionalRef"}, "observation_ref": {"$ref": "#/$defs/OptionalRef"}, "case_claim_ref": {"$ref": "#/$defs/OptionalRef"},
    "originals": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object", "additionalProperties": false,
      "required": ["ref", "kind"], "properties": {"ref": {"$ref": "#/$defs/Ref"}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"}}}}
  },
  "$defs": {
    "OptionalRef": {"anyOf": [{"$ref": "#/$defs/Ref"}, {"type": "null"}]},
    "Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
