{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-runtime-readiness:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ai4r-rsi-runtime-readiness:1"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "session_ref": {
      "$ref": "#/$defs/Ref"
    },
    "target_profile_ref": {
      "$ref": "#/$defs/Ref"
    },
    "worker_profile_ref": {
      "$ref": "#/$defs/Ref"
    },
    "read_only": {
      "const": true
    },
    "eligible_for": {
      "const": "human_session_start"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": {
            "enum": [
              "IF015_AUTHORITY",
              "FROZEN_TARGETS",
              "OPPORTUNITY_PREPARATION",
              "WORKER_RUNTIME",
              "CUSTODIAN_RUNTIME",
              "MODEL_RUNTIME",
              "DIAGNOSIS_RUNTIME",
              "SESSION_HISTORY"
            ]
          },
          "state": {
            "enum": [
              "READY",
              "BLOCKED"
            ]
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Ref"
            },
            "minItems": 0,
            "maxItems": 1024
          }
        },
        "required": [
          "check",
          "state",
          "proof_refs"
        ]
      },
      "minItems": 8,
      "maxItems": 8
    },
    "blockers": {
      "type": "array",
      "items": {
        "enum": [
          "IF015_AUTHORITY",
          "FROZEN_TARGETS",
          "OPPORTUNITY_PREPARATION",
          "WORKER_RUNTIME",
          "CUSTODIAN_RUNTIME",
          "MODEL_RUNTIME",
          "DIAGNOSIS_RUNTIME",
          "SESSION_HISTORY"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    }
  },
  "required": [
    "schema",
    "status",
    "session_ref",
    "target_profile_ref",
    "worker_profile_ref",
    "read_only",
    "eligible_for",
    "findings",
    "blockers"
  ],
  "$defs": {
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ]
    }
  }
}
