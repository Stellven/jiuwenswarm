{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:scientific-attempt-preflight:1",
  "x-owning-interface": "M1-IF-001@r2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai4r-scientific-attempt-preflight:1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "preparation_ref": {
      "$ref": "#/$defs/Ref"
    },
    "science_runtime_ref": {
      "$ref": "#/$defs/Ref"
    },
    "broker_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_unix_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "id",
    "preparation_ref",
    "science_runtime_ref",
    "broker_instance_id",
    "recorded_unix_ns"
  ],
  "additionalProperties": false,
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Registered original typed data only; implementation remains pending/unbuilt. Actual live prepared/active owner, custody kind/hash/joins, deadlines/cancellation, global lease and actual service/kernel evidence are independent mandatory checks; this data grants no authority."
}
