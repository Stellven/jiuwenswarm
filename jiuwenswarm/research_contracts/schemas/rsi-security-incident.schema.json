{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:private:rsi-security-incident:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "session_id", "session_ref", "operator_id", "violation", "recorded_at"],
  "properties": {
    "schema": {"const": "ai4r-rsi-security-incident:1"},
    "session_id": {"type": "string", "minLength": 1},
    "session_ref": {"$ref": "#/$defs/Ref"},
    "operator_id": {"type": "string", "minLength": 1},
    "violation": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {"Ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"],
    "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
