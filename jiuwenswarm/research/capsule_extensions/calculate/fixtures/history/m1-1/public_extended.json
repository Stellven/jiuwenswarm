  {
   "id": "large-decimal-ties",
   "note": "Large decimal-string table whose extremes repeat in two representations",
   "data": {
    "table": {
     "columns": {
      "$list": {
       "n": 8,
       "var": "i",
       "item": {
        "$fmt": "d{i}"
       }
      }
     },
     "rows": {
      "$concat": [
       {
        "$list": {
         "n": 1200,
         "var": "r",
         "item": {
          "$list": {
           "n": 8,
           "var": "j",
           "item": {
            "$concat": [
             {
              "$str": {
               "$int": {
                "terms": {
                 "r": 13,
                 "j": 1
                },
                "add": 0,
                "mod": 500
               }
              }
             },
             ".5"
            ]
           }
          }
         }
        }
       },
       {
        "$list": {
         "n": 1200,
         "var": "r",
         "item": {
          "$list": {
           "n": 8,
           "var": "j",
           "item": {
            "$concat": [
             {
              "$str": {
               "$int": {
                "terms": {
                 "r": 17,
                 "j": 3
                },
                "add": 0,
                "mod": 500
               }
              }
             },
             ".50"
            ]
           }
          }
         }
        }
       }
      ]
     }
    },
    "calculation": {
     "columns": [
      "d7",
      "d0",
      "d3"
     ],
     "operations": [
      "count",
      "sum",
      "mean",
      "min",
      "max"
     ],
     "numeric_mode": "decimal_strings"
    }
   },
   "expected_task_output": {
    "arithmetic": "decimal128_half_even",
    "columns": {
     "d7": {
      "count": 2400,
      "sum": "597300.00",
      "mean": "248.875",
      "min": "0.5",
      "max": "499.50"
     },
     "d0": {
      "count": 2400,
      "sum": "597200.00",
      "mean": "248.83333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333",
      "min": "0.5",
      "max": "499.50"
     },
