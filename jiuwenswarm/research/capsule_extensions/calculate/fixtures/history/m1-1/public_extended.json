{
 "schema": "ai4r-rsi-capsule-fixture-set:1",
 "fixture_set": "public_extended",
 "notes": "Harder public cases (edge cases, ties, unicode, near-limit tables). Expected outputs follow the independent checker.",
 "defaults": {
  "data": {
   "unrelated": {
    "preserve": [
     "exact",
     7,
     null
    ]
   }
  },
  "files": [
   [
    "input.txt",
    "retained input"
   ]
  ]
 },
 "cases": [
  {
   "id": "max-tie-trailing-zeros",
   "note": "Equal maxima with different representations: ordering-stable result required",
   "data": {
    "table": {
     "columns": [
      "price",
      "qty"
     ],
     "rows": [
      [
       "1.0",
       "2"
      ],
      [
       "0.5",
       "3"
      ],
      [
       "1.00",
       "2.0"
      ]
     ]
    },
    "calculation": {
     "columns": [
      "price",
      "qty"
     ],
     "operations": [
      "min",
      "max",
      "count"
     ],
     "numeric_mode": "decimal_strings"
    }
   },
   "expected_task_output": {
    "arithmetic": "decimal128_half_even",
    "columns": {
     "price": {
      "min": "0.5",
      "max": "1.00",
      "count": 3
     },
     "qty": {
      "min": "2",
      "max": "3",
      "count": 3
     }
    }
   }
  },
  {
   "id": "exponent-equivalents",
   "note": "Exponent and signed forms of equal values",
   "data": {
    "table": {
     "columns": [
      "x"
     ],
     "rows": [
      [
       "1e1"
      ],
      [
       "10"
      ],
      [
       "+10.0"
      ],
      [
       "-0"
      ],
      [
       "0"
      ],
