{
 "schema": "ai4r-rsi-capsule-fixture-set:1",
 "fixture_set": "public",
 "notes": "Synthetic representative fixtures frozen from selected table_normalize_typed and independently checked; canonical Normalize templates preserve exactly the same expanded inputs and expected outputs.",
 "defaults": {
  "data": {
   "unrelated": {
    "keep": true
   }
  },
  "files": [
   [
    "notes.txt",
    "retained <untrusted> content"
   ]
  ]
 },
 "cases": [
  {
   "id": "quoted-csv",
   "data": {
    "table_request": {
     "file": "source.txt",
     "format": "csv",
     "columns": [
      "name",
      "value"
     ],
     "delimiter": ","
    }
   },
   "files": [
    [
     "source.txt",
     "name,value\r\n\"a,b\",\"001\"\r\n\"multi\nline\",2\r\n"
    ]
   ],
   "expected_task_output": {
    "columns": [
     "name",
     "value"
    ],
    "rows": [
     [
      "a,b",
      "001"
     ],
     [
      "multi\nline",
      "2"
     ]
    ]
   }
  },
  {
   "id": "json-types-order",
   "data": {
    "table_request": {
     "file": "source.txt",
     "format": "json",
     "columns": [
      "b",
      "a"
     ],
     "delimiter": null
    }
   },
   "files": [
    [
     "source.txt",
     "[{\"a\":null,\"b\":true},{\"a\":2.5,\"b\":\"001\"}]"
    ]
   ],
   "expected_task_output": {
    "columns": [
     "b",
     "a"
    ],
    "rows": [
     [
      true,
      null
     ],
     [
      "001",
      2.5
     ]
    ]
   }
  },
  {
   "id": "empty-csv",
   "data": {
    "table_request": {
     "file": "source.txt",
     "format": "csv",
     "columns": [
      "v"
     ],
     "delimiter": ","
    }
   },
   "files": [
    [
     "source.txt",
     "v\n"
    ]
   ],
   "expected_task_output": {
    "columns": [
     "v"
    ],
    "rows": []
   }
  },
  {
   "id": "semicolon-csv",
   "data": {
    "table_request": {
     "file": "source.txt",
     "format": "csv",
     "columns": [
      "x",
      "y"
     ],
     "delimiter": ";"
    }
   },
   "files": [
    [
     "source.txt",
     "x;y\nα;β\n"
    ]
   ],
   "expected_task_output": {
    "columns": [
     "x",
     "y"
    ],
    "rows": [
     [
      "α",
      "β"
     ]
    ]
   }
  },
  {
   "id": "large-public",
   "data": {
    "table_request": {
     "file": "source.txt",
     "format": "csv",
     "columns": [
      "id",
      "label"
     ],
     "delimiter": ","
    }
   },
   "files": [
    [
     "source.txt",
     {
      "$concat": [
       "id,label\n",
       {
        "$join": {
         "sep": "",
         "items": {
          "$list": {
           "n": 2000,
           "var": "i",
           "item": {
            "$fmt": "{i},row-{i}\n"
           }
          }
         }
        }
       }
      ]
     }
    ]
   ],
   "expected_task_output": {
    "columns": [
     "id",
     "label"
    ],
    "rows": {
     "$list": {
      "n": 2000,
      "var": "i",
      "item": [
       {
        "$fmt": "{i}"
       },
       {
        "$fmt": "row-{i}"
       }
      ]
     }
    }
   }
  }
 ]
}
