diff --git a/src/llama-expert-fill.h b/src/llama-expert-fill.h
new file mode 100644
index 000000000..13210351a
--- /dev/null
+++ b/src/llama-expert-fill.h
@@ -0,0 +1,306 @@
+#pragma once
+
+// Demand-driven parallel expert fill (off by default; LLAMA_EXPERT_FILL=1 turns it on).
+//
+// After the router of a layer has selected its experts (the ffn_moe_topk-<il> node) and before the expert
+// matmuls run, the selected experts' byte ranges that are mmap-backed and not resident in the page cache are
+// read with a pool of parallel buffered preads, so the matmuls take minor faults instead of serial major faults.
+// The fill only warms the page cache: it never writes tensor data and never changes the graph.
+//
+// Environment (read once per context):
+//   LLAMA_EXPERT_FILL=0|1                 default 0 (off)
+//   LLAMA_EXPERT_FILL_THREADS=1..64       default 8 (read queue depth)
+//   LLAMA_EXPERT_FILL_CHUNK_KIB=64..65536 default 1024 (bytes per pread)
+//   LLAMA_EXPERT_FILL_MAX_TOKENS=0..      default 1 (fill only ubatches of at most this many tokens: decode;
+//                                         0 = every ubatch, prefill included)
+//   LLAMA_EXPERT_FILL_SKIP_RESIDENT=0|1   default 1 (mincore first; 0 reads every selected range, for calibration)
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#if defined(__linux__)
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#define LLAMA_EXPERT_FILL_SUPPORTED 1
+#else
+#define LLAMA_EXPERT_FILL_SUPPORTED 0
+#endif
+
+struct llama_expert_fill_config {
+    bool     enabled       = false;
+    int      threads       = 8;
+    size_t   chunk         = 1u << 20;
+    uint32_t max_tokens    = 1;
+    bool     skip_resident = true;
+
+    static long env_long(const char * name, long def, long lo, long hi) {
+        const char * v = std::getenv(name);
+        if (v == nullptr || *v == '\0') {
+            return def;
+        }
+        char * end = nullptr;
+        const long x = std::strtol(v, &end, 10);
+        if (end == v || *end != '\0' || x < lo || x > hi) {
+            return def;
+        }
+        return x;
+    }
+
+    static llama_expert_fill_config from_env() {
+        llama_expert_fill_config c;
+        c.enabled       = env_long("LLAMA_EXPERT_FILL", 0, 0, 1) == 1;
+        c.threads       = (int) env_long("LLAMA_EXPERT_FILL_THREADS", 8, 1, 64);
+        c.chunk         = (size_t) env_long("LLAMA_EXPERT_FILL_CHUNK_KIB", 1024, 64, 65536) * 1024;
+        c.max_tokens    = (uint32_t) env_long("LLAMA_EXPERT_FILL_MAX_TOKENS", 1, 0, 1L << 30);
+        c.skip_resident = env_long("LLAMA_EXPERT_FILL_SKIP_RESIDENT", 1, 0, 1) == 1;
+        return c;
+    }
+};
+
+struct llama_expert_fill_stats {
+    uint64_t calls           = 0; // layers filled
+    uint64_t ranges          = 0; // expert ranges considered
+    uint64_t bytes_requested = 0; // bytes of the selected experts
+    uint64_t bytes_resident  = 0; // already in the page cache (skipped)
+    uint64_t bytes_read      = 0;
+    uint64_t reads           = 0; // pread calls
+    uint64_t read_errors     = 0;
+    uint64_t unmapped        = 0; // ranges not backed by a file mapping (skipped)
+    uint64_t fill_ns         = 0;
+    uint64_t max_fill_ns     = 0;
+};
+
+class llama_expert_fill {
+public:
+    explicit llama_expert_fill(const llama_expert_fill_config & cfg) : cfg(cfg) {
+        for (int i = 0; i < cfg.threads; ++i) {
+            workers.emplace_back([this] { work(); });
+        }
+    }
+
+    ~llama_expert_fill() {
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            stop = true;
+        }
+        cv_work.notify_all();
+        for (auto & w : workers) {
+            w.join();
+        }
+#if LLAMA_EXPERT_FILL_SUPPORTED
+        for (auto & kv : fds) {
+            if (kv.second >= 0) {
+                close(kv.second);
+            }
+        }
+#endif
+    }
+
+    const llama_expert_fill_config cfg;
+    llama_expert_fill_stats        stats;
+
+    // read the non-resident parts of [addr, addr + len) for each range; returns when every read finished
+    void fill(const std::vector<std::pair<const uint8_t *, size_t>> & ranges) {
+        const auto t0 = std::chrono::steady_clock::now();
+        std::vector<task> todo;
+        for (const auto & r : ranges) {
+            stats.ranges++;
+            stats.bytes_requested += r.second;
+            plan(r.first, r.second, todo);
+        }
+        if (!todo.empty()) {
+            {
+                std::lock_guard<std::mutex> lk(mtx);
+                tasks   = std::move(todo);
+                next    = 0;
+                pending = tasks.size();
+            }
+            cv_work.notify_all();
+            std::unique_lock<std::mutex> lk(mtx);
+            cv_done.wait(lk, [this] { return pending == 0; });
+            tasks.clear();
+        }
+        const uint64_t ns = (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now() - t0).count();
+        stats.calls++;
+        stats.fill_ns    += ns;
+        stats.max_fill_ns = std::max(stats.max_fill_ns, ns);
+    }
+
+private:
+    struct task {
+        int      fd;
+        uint64_t off;
+        size_t   len;
+    };
+
+    struct region {
+        uintptr_t   start;
+        uintptr_t   end;
+        uint64_t    pgoff;
+        std::string path;
+    };
+
+    std::vector<region>        regions;
+    std::map<std::string, int> fds;
+
+    std::mutex              mtx;
+    std::condition_variable cv_work;
+    std::condition_variable cv_done;
+    std::vector<task>       tasks;
+    size_t                  next    = 0;
+    size_t                  pending = 0;
+    bool                    stop    = false;
+    std::vector<std::thread> workers;
+
+    void load_maps() {
+        regions.clear();
+        FILE * f = std::fopen("/proc/self/maps", "r");
+        if (f == nullptr) {
+            return;
+        }
+        char line[4096];
+        while (std::fgets(line, sizeof(line), f)) {
+            unsigned long long s = 0, e = 0, off = 0;
+            char perms[8] = {0};
+            int  n = 0;
+            if (std::sscanf(line, "%llx-%llx %7s %llx %*s %*s %n", &s, &e, perms, &off, &n) < 4 || n <= 0) {
+                continue;
+            }
+            std::string path(line + n);
+            while (!path.empty() && (path.back() == '\n' || path.back() == ' ')) {
+                path.pop_back();
+            }
+            if (path.empty() || path[0] != '/') {
+                continue;
+            }
+            regions.push_back({ (uintptr_t) s, (uintptr_t) e, (uint64_t) off, path });
+        }
+        std::fclose(f);
+    }
+
+    const region * find(uintptr_t a, size_t len, bool retry = true) {
+        for (const auto & r : regions) {
+            if (a >= r.start && a + len <= r.end) {
+                return &r;
+            }
+        }
+        if (retry) {
+            load_maps();
+            return find(a, len, false);
+        }
+        return nullptr;
+    }
+
+    int fd_of(const std::string & path) {
+#if LLAMA_EXPERT_FILL_SUPPORTED
+        auto it = fds.find(path);
+        if (it == fds.end()) {
+            it = fds.emplace(path, open(path.c_str(), O_RDONLY | O_CLOEXEC)).first;
+        }
+        return it->second;
+#else
+        (void) path;
+        return -1;
+#endif
+    }
+
+    // split the non-resident pages of one range into pread tasks
+    void plan(const uint8_t * addr, size_t len, std::vector<task> & out) {
+#if LLAMA_EXPERT_FILL_SUPPORTED
+        if (len == 0) {
+            return;
+        }
+        const region * r = find((uintptr_t) addr, len);
+        const int fd = r ? fd_of(r->path) : -1;
+        if (r == nullptr || fd < 0) {
+            stats.unmapped++;
+            return;
+        }
+        const size_t    page  = (size_t) sysconf(_SC_PAGESIZE);
+        const uintptr_t first = (uintptr_t) addr & ~(uintptr_t) (page - 1);
+        const uintptr_t last  = ((uintptr_t) addr + len + page - 1) & ~(uintptr_t) (page - 1);
+        const size_t    npage = (last - first) / page;
+        std::vector<unsigned char> res(npage, 0);
+        if (cfg.skip_resident && mincore((void *) first, last - first, res.data()) != 0) {
+            std::fill(res.begin(), res.end(), 0);
+        }
+        size_t p = 0;
+        while (p < npage) {
+            if (res[p] & 1) {
+                stats.bytes_resident += page;
+                p++;
+                continue;
+            }
+            size_t q = p;
+            while (q < npage && !(res[q] & 1)) {
+                q++;
+            }
+            uint64_t off = r->pgoff + (first + p*page - r->start);
+            size_t   n   = (q - p)*page;
+            while (n > 0) {
+                const size_t c = std::min(n, cfg.chunk);
+                out.push_back({ fd, off, c });
+                off += c;
+                n   -= c;
+            }
+            p = q;
+        }
+#else
+        (void) addr;
+        (void) len;
+        (void) out;
+        stats.unmapped++;
+#endif
+    }
+
+    void work() {
+        std::vector<uint8_t> buf(cfg.chunk);
+        for (;;) {
+            task t;
+            {
+                std::unique_lock<std::mutex> lk(mtx);
+                cv_work.wait(lk, [this] { return stop || next < tasks.size(); });
+                if (stop) {
+                    return;
+                }
+                t = tasks[next++];
+            }
+            uint64_t got = 0, nread = 0, errs = 0;
+#if LLAMA_EXPERT_FILL_SUPPORTED
+            while (got < t.len) {
+                const ssize_t r = pread(t.fd, buf.data(), std::min(buf.size(), (size_t) (t.len - got)), (off_t) (t.off + got));
+                nread++;
+                if (r <= 0) {
+                    errs++;
+                    break;
+                }
+                got += (uint64_t) r;
+            }
+#endif
+            {
+                std::lock_guard<std::mutex> lk(mtx);
+                stats.bytes_read  += got;
+                stats.reads       += nread;
+                stats.read_errors += errs;
+                if (--pending == 0) {
+                    cv_done.notify_all();
+                }
+            }
+        }
+    }
+};
