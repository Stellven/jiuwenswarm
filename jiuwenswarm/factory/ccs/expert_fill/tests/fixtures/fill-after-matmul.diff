+bool llama_context::expert_fill_eval(ggml_tensor * t, bool ask, void * user_data) {
+    auto * lctx = static_cast<llama_context *>(user_data);
+    static const char prefix[] = "ffn_moe_down-";
+    const bool ours = lctx->expert_fill_this_ubatch && std::strncmp(ggml_get_name(t), prefix, sizeof(prefix) - 1) == 0;
+    auto * user = lctx->expert_fill_user_cb;
+    if (ask) {
+        return ours || (user && user(t, true, lctx->expert_fill_user_data));
+    }
+    if (ours) {
+        lctx->expert_fill_layer(t);
+    }
+    if (user && user(t, true, lctx->expert_fill_user_data)) {
+        return user(t, false, lctx->expert_fill_user_data);
+    }
+    return true;
+}
+
+void llama_context::expert_fill_layer(const ggml_tensor * topk) {
+    const int il = std::atoi(ggml_get_name(topk) + std::strlen("ffn_moe_down-"));
+    if (il < 0 || il >= (int) model.layers.size() || topk->type != GGML_TYPE_I32 || topk->buffer == nullptr) {
+        return;
+    }
+    // the router output: [n_expert_used, n_tokens] I32, possibly a strided view
+    std::vector<uint8_t> raw(ggml_nbytes(topk));
+    ggml_backend_tensor_get(topk, raw.data(), 0, raw.size());
+
+    const auto & layer = model.layers[il];
+    const ggml_tensor * exps[] = { layer.ffn_up_exps, layer.ffn_gate_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps };
+
+    std::vector<int32_t> ids;
+    for (int64_t i1 = 0; i1 < topk->ne[1]; ++i1) {
+        for (int64_t i0 = 0; i0 < topk->ne[0]; ++i0) {
+            int32_t id;
+            std::memcpy(&id, raw.data() + i1*topk->nb[1] + i0*topk->nb[0], sizeof(id));
+            ids.push_back(id);
+        }
+    }
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+
+    std::vector<std::pair<const uint8_t *, size_t>> ranges;
+    for (const ggml_tensor * w : exps) {
+        if (w == nullptr || w->data == nullptr || w->buffer == nullptr || !ggml_backend_buffer_is_host(w->buffer)) {
+            continue;
+        }
+        for (const int32_t id : ids) {
+            if (id >= 0 && id < w->ne[2]) {
+                ranges.emplace_back((const uint8_t *) w->data + (size_t) id*w->nb[2], (size_t) w->nb[2]);
+            }
+        }
+    }
+    expert_fill->fill(ranges);
+}
