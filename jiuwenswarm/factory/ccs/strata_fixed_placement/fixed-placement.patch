index 00000000..ba394b0a
--- /dev/null
+++ b/src/dsv41/ds4_fixed_placement.hpp
@@ -0,0 +1,32 @@
+// Opt-in deterministic expert-budget helpers. No CUDA dependency.
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+namespace strata::ds4::fixed_placement {
+inline bool parse_budget(const char* text, uint64_t& value) {
+    constexpr uint64_t maximum = 9007199254740991ULL; // exact integer in double
+    if (text == nullptr || *text == '\0') return false;
+    uint64_t result = 0;
+    for (const char* p = text; *p; ++p) {
+        if (*p < '0' || *p > '9') return false;
+        const uint64_t digit = (uint64_t) (*p - '0');
+        if (result > (maximum - digit) / 10) return false;
+        result = result * 10 + digit;
+    }
+    if (result == 0) return false;
+    value = result;
+    return true;
+}
+inline bool fits(uint64_t requested, double safe) {
+    return requested > 0 && std::isfinite(safe) && safe >= (double) requested;
+}
+inline uint64_t hash_initial() { return 14695981039346656037ULL; }
+inline void hash_word(uint64_t& hash, uint32_t word) {
+    // Canonical little-endian uint32 fields, independent of host byte order.
+    for (int b = 0; b < 4; ++b) {
+        hash ^= (word >> (8 * b)) & 255u;
+        hash *= 1099511628211ULL;
+    }
+}
+} // namespace strata::ds4::fixed_placement
diff --git a/src/dsv41/ds4_fixed_placement_test.cpp b/src/dsv41/ds4_fixed_placement_test.cpp
new file mode 100644
index 00000000..90c8d392
--- /dev/null
+++ b/src/dsv41/ds4_fixed_placement_test.cpp
@@ -0,0 +1,24 @@
+// CPU-only helper checks; no GPU/model. Compile separately from engine.
+#include "ds4_fixed_placement.hpp"
+#include <cassert>
+#include <limits>
+#include <initializer_list>
+using namespace strata::ds4::fixed_placement;
+int main() {
+    uint64_t n = 7;
+    for (const char* bad : {"", "0", "-1", "+1", " 1", "1 ", "1.0", "1e9", "9007199254740992", "18446744073709551616"}) {
+        assert(!parse_budget(bad, n));
+        assert(n == 7);
+    }
+    assert(!parse_budget(nullptr, n));
+    assert(parse_budget("76000000000", n) && n == 76000000000ULL);
+    assert(fits(n, 76000000000.0));
+    assert(!fits(n, 75999999999.0));
+    assert(!fits(n, std::numeric_limits<double>::infinity()));
+    assert(!fits(n, std::numeric_limits<double>::quiet_NaN()));
+    uint64_t a = hash_initial(), b = hash_initial();
+    hash_word(a, 0x01020304); hash_word(b, 0x01020304);
+    assert(a == b);
+    hash_word(b, 1); assert(a != b);
+    assert(parse_budget("9007199254740991", n) && n == 9007199254740991ULL);
+}
