{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:factory:task-graph-proposal:v1",
  "title": "Planner Task Graph Proposal",
  "type": "object",
  "required": ["nodes", "outputs"],
  "properties": {
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "workflow", "subworkflow", "bindings"],
        "properties": {
          "id": {"$ref": "#/$defs/identity"},
          "workflow": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"$ref": "#/$defs/identity"},
              "version": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "subworkflow": {"$ref": "#/$defs/identity"},
          "parameters": {"type": "object"},
          "bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/binding"}}
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["artifact_id"], "additionalProperties": false,
        "properties": {"artifact_id": {"type": "string", "minLength": 1}}
      }
    },
    "outputs": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/binding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"},
    "binding": {
      "type": "object", "required": ["node", "port"], "additionalProperties": false,
      "properties": {"node": {"type": "string", "minLength": 1}, "port": {"$ref": "#/$defs/identity"}}
    }
  }
}
