# Deny by default for directory-context builds. The frozen TAR producer also
# verifies its complete public input closure independently of this client file.
# Runner code belongs only in the runner image. Private oracle inputs,
# credentials and source-design documents are never packaging inputs.
**
!pyproject.toml
!uv.lock
!LICENSE
!OPEN_SOURCE_SOFTWARE_NOTICE.md
!pytest.ini
!.importlinter
!jiuwenswarm/
!jiuwenswarm/**
!jiuwenbox/
!jiuwenbox/**
!packages/
!packages/jiuwenswarm-tui/
!packages/jiuwenswarm-tui/**
!scripts/
!scripts/**
!tests/
!tests/**
!deploy/
!deploy/m1/
!deploy/m1/**
**/.git/**
**/node_modules/**
**/dist/**
**/__pycache__/**
**/.venv/**
**/.env
**/.env.*
**/auth.json
**/credentials.json
**/secrets.json
**/*.key
**/*.pem
**/*.p12
**/codex-home/**
**/workspace/**
**/evidence/**
**/private/**
**/protected/**
# Native frontend source uses "workspace" as a product feature directory.
!jiuwenswarm/channels/web/frontend/src/features/workspace/
!jiuwenswarm/channels/web/frontend/src/features/workspace/**
!jiuwenswarm/resources/agent/workspace/
!jiuwenswarm/resources/agent/workspace/**
jiuwenswarm/resources/agent/workspace/**/.env
jiuwenswarm/resources/agent/workspace/**/.env.*
jiuwenswarm/resources/agent/workspace/**/auth.json
jiuwenswarm/resources/agent/workspace/**/credentials.json
jiuwenswarm/resources/agent/workspace/**/secrets.json
jiuwenswarm/resources/agent/workspace/**/*.key
jiuwenswarm/resources/agent/workspace/**/*.pem
jiuwenswarm/resources/agent/workspace/**/node_modules/**
jiuwenswarm/resources/agent/workspace/**/__pycache__/**
!jiuwenswarm/resources/.env.template
jiuwenswarm/research_sidecar/**
jiuwenswarm/research_sidecar/
!jiuwenswarm/channels/web/frontend/dist/
!jiuwenswarm/channels/web/frontend/dist/**
jiuwenswarm/channels/web/frontend/dist/**/.env*
jiuwenswarm/channels/web/frontend/dist/**/auth.json
jiuwenswarm/channels/web/frontend/dist/**/credentials.json
jiuwenswarm/channels/web/frontend/dist/**/secrets.json
jiuwenswarm/channels/web/frontend/dist/**/*.key
