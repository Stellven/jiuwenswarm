# syntax=docker/dockerfile:1.7
ARG DEPENDENCY_IMAGE=ai4r-m1-app:20261021-workflow-development-3
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
FROM ${DEPENDENCY_IMAGE} AS dependencies
USER root
COPY uv.lock /build/uv.lock
COPY deploy/m1/cached_runner_deps.py /build/cached_runner_deps.py
RUN python /build/cached_runner_deps.py

FROM ${PYTHON_IMAGE} AS benchmark-runner
RUN groupadd --gid 11001 benchmark_runner \
    && useradd --uid 11001 --gid 11001 --no-create-home benchmark_runner
COPY --from=dependencies /runner-deps/ /usr/local/lib/python3.12/site-packages/
COPY --from=dependencies /runner-dependencies.json /usr/local/share/benchmark-runner-dependencies.json
WORKDIR /opt/ai4r
COPY jiuwenswarm/research_sidecar/ ./jiuwenswarm/research_sidecar/
COPY jiuwenswarm/research_records/ ./jiuwenswarm/research_records/
COPY jiuwenswarm/research_contracts/ ./jiuwenswarm/research_contracts/
RUN printf '#!/usr/local/bin/python\nfrom jiuwenswarm.research_sidecar.sequential import main\nraise SystemExit(main())\n' > /usr/local/bin/benchmark-runner \
    && chmod 0755 /usr/local/bin/benchmark-runner
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/ai4r
USER 11001:11001
ENTRYPOINT ["benchmark-runner"]
CMD ["--help"]
