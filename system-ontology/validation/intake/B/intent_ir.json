  "uncertainties": [
    {
      "id": "unc-context-length",
      "kind": "missing",
      "description": "The context length the engine must offer (a pass/fail requirement) is not given; the target notes the engine cannot be sized until it is, because attention state shares the 80 GB budget with the expert cache.",
      "affected_fields": [
        "constraints"
      ],
      "blocking": false,
      "clarification": "What context length, in tokens, must the engine offer?"
    },
    {
      "id": "unc-workload",
      "kind": "missing",
      "description": "The fixed workload used for measurement (prompt lengths and requests) is not defined, for the target as a whole and for TTFT, decode rate and peak memory.",
      "affected_fields": [
        "constraints",
        "user_targets"
      ],
      "blocking": false,
      "clarification": "What fixed workload (prompts and their lengths, output lengths, concurrency) are the measurements taken on?"
    },
    {
      "id": "unc-quality-taskset-threshold",
      "kind": "missing",
      "description": "The held-out task set and the pass threshold for the quality requirement are not named.",
      "affected_fields": [
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Which held-out task set and which pass threshold apply to the quality score?"
    },
    {
      "id": "unc-allowed-transformations",
      "kind": "missing",
      "description": "Whether quantisation below NVFP4 or approximations that change output are allowed is not set; the quality comparison (identical tokens vs a task-score threshold) depends on it.",
      "affected_fields": [
        "user_targets",
        "constraints"
      ],
      "blocking": false,
      "clarification": "Are quantisation below NVFP4 or other output-changing approximations allowed?"
    },
    {
      "id": "unc-checkpoint",
      "kind": "missing",
      "description": "Which single checkpoint is used is not set. The model offers BF16 and NVFP4; the target comments that only NVFP4 is within reach and the quality baseline names NVFP4 weights, but this is not set as a decision.",
      "affected_fields": [
        "constraints"
      ],
      "blocking": false,
      "clarification": "Is the NVFP4 checkpoint the one the engine must use?"
    },
    {
      "id": "unc-form-environment-streaming",
      "kind": "missing",
