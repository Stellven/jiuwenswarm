  "uncertainties": [
    {
      "id": "unc-context-length",
      "kind": "missing",
      "description": "The pass/fail context length is not given. The model allows 1,000,000 tokens; the target says the attention state comes from the same 80 GB budget and the engine cannot be sized until this value is given. The scope page does not give it.",
      "affected_fields": [
        "user_targets",
        "constraints"
      ],
      "blocking": false,
      "clarification": "What context length (in tokens) must the engine offer?"
    },
    {
      "id": "unc-memory-budget",
      "kind": "ambiguous",
      "description": "The scope page names three memory figures (128 GB, 12 GB, 80 GB). The target proposes 80 GB as the budget, with decimal unit basis and its accounting boundary, all as proposals to be confirmed.",
      "affected_fields": [
        "constraints",
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Is the memory budget 80 GB (decimal) in the unified pool, with the proposed accounting boundary?"
    },
    {
      "id": "unc-quality",
      "kind": "missing",
      "description": "The quality task set and pass threshold are not named; the baseline and comparison rule are proposals.",
      "affected_fields": [
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Which held-out task set and which pass threshold judge quality, and is the proposed baseline confirmed?"
    },
    {
      "id": "unc-allowed-transformations",
      "kind": "missing",
      "description": "Whether quantisation below NVFP4 or approximations that change output are allowed is not stated; the quality comparison rule depends on it.",
      "affected_fields": [
        "constraints",
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Are quantisation below NVFP4 or output-changing approximations allowed?"
    },
    {
      "id": "unc-workload",
      "kind": "missing",
      "description": "The fixed workload is not defined; prompt lengths decide the time to first token, and the ttft, decode-rate and peak-memory reports each lack a workload.",
      "affected_fields": [
        "user_targets"
      ],
      "blocking": false,
      "clarification": "What fixed workload (prompts and lengths) are the reported quantities measured on?"
    },
    {
      "id": "unc-form",
      "kind": "missing",
      "description": "The engine's form is not decided: execution library, offline engine or online service. Streaming is also not decided.",
      "affected_fields": [
        "interpretation",
        "in_scope"
      ],
      "blocking": false,
      "clarification": "Should the engine be an execution library, an offline engine or an online service, and must it stream output?"
    },
    {
      "id": "unc-environment",
      "kind": "missing",
      "description": "The software environment is not given.",
      "affected_fields": [
        "context",
        "constraints"
      ],
      "blocking": false,
      "clarification": "What software environment (operating system, drivers, toolchain) does the engine run in?"
    },
    {
      "id": "unc-checkpoint",
      "kind": "missing",
      "description": "The model checkpoint is not chosen. The scope page asks for one checkpoint; the model card offers BF16 and NVFP4, and the target notes that only NVFP4 is within reach.",
      "affected_fields": [
        "constraints",
        "context"
      ],
      "blocking": false,
      "clarification": "Which checkpoint (NVFP4 or BF16) is the engine built for?"
    },
    {
      "id": "unc-vram-vs-budget",
      "kind": "ambiguous",
      "description": "The model card states 700 GB of VRAM required at NVFP4, which exceeds the machine's 128 GB nominal memory and the proposed 80 GB budget. The sources do not say how that card figure relates to the requested engine; this is the setting of the request, not a contradiction between two user requirements.",
      "affected_fields": [
        "interpretation",
        "constraints"
      ],
      "blocking": false,
      "clarification": "None needed to start; confirm the 80 GB budget (see unc-memory-budget)."
    },
    {
      "id": "unc-model-sizes",
      "kind": "missing",
      "description": "Weight sizes are derived from the card's totals under a stated assumption, not read; the attention state size per token is not on the card and must be read from config.json, which was not read; whether the output head is tied to the embedding is not stated.",
      "affected_fields": [
        "context"
      ],
      "blocking": false,
      "clarification": "Can config.json and the weight file headers be supplied to replace the derived sizes?"
    },
    {
      "id": "unc-ssd-bandwidth",
      "kind": "missing",
      "description": "The SSD read bandwidth is not given by the vendor and is to be measured on the machine; the SSD capacity depends on the configuration.",
      "affected_fields": [
        "context"
      ],
      "blocking": false,
      "clarification": "What is the measured SSD read bandwidth and actual capacity of the target machine?"
    },
    {
      "id": "unc-modality",
      "kind": "ambiguous",
      "description": "The model accepts text, image, video and audio and has a perception encoder for the non-text modalities, while the required interface is text in and text out. The sources do not say explicitly whether the perception encoder is excluded from the engine.",
      "affected_fields": [
        "in_scope",
        "out_of_scope",
        "context"
      ],
      "blocking": false,
      "clarification": "Is the perception encoder (image, video, audio input) out of scope for the engine?"
    },
    {
      "id": "unc-scope-page",
      "kind": "missing",
      "description": "The target cites a scope page (scope-slide) as the source of its stated items, but that scope page is not among the supplied sources. Separately, the vendor states the machine's memory only in GB without saying decimal or binary.",
      "affected_fields": [
        "constraints",
        "user_targets",
        "context"
      ],
      "blocking": false,
      "clarification": "Can the scope page cited by the target be supplied?"
    }
  ],
  "readiness": {
    "status": "ready",
    "reason": "The purpose (a custom inference engine for Meta Muse Spark Open on NVIDIA DGX Spark), the required text interface, container packaging, the judging target and the four required deliverables are stated, so Requirements can start without inventing the work. All listed uncertainties are missing or unconfirmed parameters (context length, thresholds, workload, form, environment, checkpoint, proposed budget) that Requirements can carry as unresolved items; none leaves the requested work unknown and no two required constraints contradict each other, so none is blocking."
  },
