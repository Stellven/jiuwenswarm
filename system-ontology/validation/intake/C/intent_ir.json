  "uncertainties": [
    {
      "id": "unc-expert-routing-conflict",
      "kind": "conflicting",
      "description": "The given model selects 8 of 256 experts per token per layer (model card, system summary, node startup sizing), but the node-level expert router, which the user gives as part of what is wanted, turns the feed-forward input into 512 logits and chooses 10 experts, and the system flow routed-experts carries 10 expert ids per token. The engine description contradicts the given model on the routing it must implement.",
      "affected_fields": [
        "context",
        "in_scope",
        "constraints"
      ],
      "blocking": true,
      "clarification": "Which routing must the engine implement: the model's 8 of 256 experts per token per layer, or the 10 of 512 stated by the expert router node and the routed-experts flow? If the model governs, confirm that the node and flow statements are to be corrected."
    },
    {
      "id": "unc-context-length",
      "kind": "missing",
      "description": "The context length the engine must offer is not given; the target says the engine cannot be sized until it is. The node-level run configuration recommends 131072, which the target does not adopt.",
      "affected_fields": [
        "user_targets",
        "preferences"
      ],
      "blocking": false,
      "clarification": "What context length (tokens) must the engine offer?"
    },
    {
      "id": "unc-memory-budget-proposed",
      "kind": "ambiguous",
      "description": "The 80 GB memory budget, its decimal unit basis and its accounting boundary are proposals awaiting confirmation; the scope page names three figures (128 GB, 12 GB, 80 GB).",
      "affected_fields": [
        "constraints",
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Confirm or replace the 80 GB decimal budget and its accounting boundary."
    },
    {
      "id": "unc-quality-taskset-threshold",
      "kind": "missing",
      "description": "The held-out task set and the pass threshold for the quality score are not given.",
      "affected_fields": [
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Which held-out task set and which pass threshold judge quality?"
    },
    {
      "id": "unc-allowed-transformations",
      "kind": "missing",
      "description": "Whether quantisation below NVFP4 or approximations that change output are allowed is not stated; this also decides which quality comparison applies.",
      "affected_fields": [
        "constraints",
        "user_targets"
      ],
      "blocking": false,
      "clarification": "Are quantisation below NVFP4 or output-changing approximations allowed?"
    },
    {
      "id": "unc-workload",
      "kind": "missing",
      "description": "The fixed workload (including prompt lengths) on which time to first token, decode rate and peak memory are reported is not defined.",
      "affected_fields": [
        "user_targets"
      ],
      "blocking": false,
      "clarification": "What fixed workload, including prompt lengths, is used for the benchmark report?"
    },
    {
      "id": "unc-checkpoint",
      "kind": "missing",
      "description": "The model checkpoint is not chosen; the target notes the model card offers BF16 and NVFP4 and only NVFP4 is within reach.",
      "affected_fields": [
        "constraints"
      ],
      "blocking": false,
      "clarification": "Which checkpoint (BF16 or NVFP4) is the engine built for?"
    },
    {
      "id": "unc-boundary-form",
      "kind": "ambiguous",
      "description": "The engine's form (execution library, offline engine or online service) is unset in the target, while the system and node descriptions include an HTTP front accepting OpenAI- and Anthropic-shaped requests.",
      "affected_fields": [
        "in_scope",
        "constraints"
      ],
      "blocking": false,
      "clarification": "Is the engine delivered as an execution library, an offline engine or an online service?"
    },
    {
      "id": "unc-streaming-environment",
      "kind": "missing",
      "description": "Whether output is streamed, and the software environment, are unset in the target.",
      "affected_fields": [
        "constraints"
      ],
      "blocking": false,
      "clarification": "Is streaming output required, and what software environment is given?"
    },
    {
      "id": "unc-drafting-residue",
      "kind": "conflicting",
      "description": "Drafting is excluded from the first version, but some system flows still describe drafts (token lines per verify window when drafts are accepted; drafts counted in end-of-request figures).",
      "affected_fields": [
        "in_scope",
        "out_of_scope"
      ],
      "blocking": false,
      "clarification": "Confirm that draft-related flow behaviour is excluded together with drafting."
    },
    {
      "id": "unc-multi-card-and-ngram",
      "kind": "ambiguous",
      "description": "Node and flow descriptions refer to several cards and to an n-gram table, while the machine has one GPU and the model card names no lookup table.",
      "affected_fields": [
        "in_scope",
        "context"
      ],
      "blocking": false,
      "clarification": "Confirm that multi-card device selection and n-gram table handling do not apply to this engine."
    },
    {
      "id": "unc-expert-arena",
      "kind": "ambiguous",
      "description": "The system summary keeps all experts on storage and reads missed experts on demand, but the flow expert-bytes-from-files describes every routed expert read into an arena at startup, with a file-source mode as the alternative.",
      "affected_fields": [
        "in_scope"
      ],
      "blocking": false,
      "clarification": "Confirm that experts are read on demand from storage (file-source mode) rather than loaded into an arena at startup."
    },
    {
      "id": "unc-model-unknowns",
      "kind": "missing",
      "description": "Model facts the engine depends on are not in the sources: per-token attention key/value size (config.json not read), separate sizes of expert and other weights (derived under an assumption), whether the output head is tied to the embedding; SSD read bandwidth of the machine is not given.",
      "affected_fields": [
        "context"
      ],
      "blocking": false,
      "clarification": "None needed from the user; these are facts to be read from the model files and measured on the machine."
    }
  ],
  "readiness": {
    "status": "needs_clarification",
    "reason": "Purpose and requested result are clear, but one required statement conflicts: the engine description the user gives as what is wanted routes 10 of 512 experts, while the given model routes 8 of 256 (unc-expert-routing-conflict). Contradictory required constraints are blocking. All other uncertainties are missing or ambiguous parameters that Requirements can carry as unresolved items."
  },
