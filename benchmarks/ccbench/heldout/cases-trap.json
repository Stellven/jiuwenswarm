       -1,
       -1,
       1
      ],
      "o": [
       -9
      ]
     }
    ],
    "expect": [
     "o"
    ]
   }
  ]
 },
 {
  "id": "is_anagram",
  "function": "is_anagram",
  "trap": "strings are compared after NFKC normalization and full case folding (casefold), not lower()",
  "spec": "is_anagram(a, b) returns True when two strings use the same characters the same number of times after this normalization, applied to each string in this order: (1) Unicode NFKC normalization (unicodedata.normalize('NFKC', ...)); (2) full case folding as done by Python str.casefold(), so 'ß' becomes 'ss'; (3) removal of every character for which str.isspace() is True. Order does not matter, only the count of each character. Return a bool.",
  "examples": [
   "is_anagram('Dusty', 'study') == True",
   "is_anagram('abc', 'abcd') == False"
  ],
  "gate": [
   {
    "args": [
     "listen",
     "Silent"
    ],
    "expect": true
   },
   {
    "args": [
     "Straße",
     "ESSTRAS"
    ],
    "expect": true
   },
   {
    "args": [
     "abc",
     "abd"
    ],
    "expect": false
   },
   {
    "args": [
     "a b",
     "ba"
    ],
    "expect": true
   }
  ],
  "score": [
   {
    "args": [
     "ﬁsh",
     "HSIF"
    ],
    "expect": true
   },
   {
    "args": [
     "Maße",
     "ssame"
    ],
    "expect": true
   },
   {
    "args": [
     "ς",
     "Σ"
    ],
    "expect": true
   },
   {
    "args": [
     "１２３",
     "321"
    ],
    "expect": true
   },
   {
    "args": [
     "ab",
     "ABc"
    ],
    "expect": false
   },
   {
    "args": [
     "x y",
     "yx"
    ],
    "expect": true
   },
   {
    "args": [
     "ss",
     "ß"
    ],
    "expect": true
   },
   {
    "args": [
     "straße",
     "strase"
    ],
    "expect": false
   },
   {
    "args": [
     "é",
     "é"
    ],
    "expect": true
   }
  ]
 },
 {
  "id": "to_cents",
  "function": "to_cents",
  "trap": "ties round half to EVEN (banker's rounding), on the exact decimal, not half up",
  "spec": "to_cents(amount) takes a money amount written as a decimal string: an optional leading '-', one or more digits, and optionally a '.' followed by one or more digits (for example '12', '-0.5', '3.14159'). It returns the amount in cents as an int: amount times 100, rounded to the nearest integer. When the value is exactly halfway between two integers it rounds to the even one (round half to even, so 2.5 -> 2 and 3.5 -> 4 and -2.5 -> -2). Work on the exact decimal value, not on a binary float. Zero is returned as 0.",
  "examples": [
   "to_cents('1.23') == 123",
   "to_cents('-0.5') == -50"
  ],
  "gate": [
   {
    "args": [
     "1.005"
    ],
    "expect": 100
   },
   {
    "args": [
     "2.50"
    ],
    "expect": 250
   },
   {
    "args": [
     "0.015"
    ],
    "expect": 2
   },
   {
    "args": [
     "12"
    ],
    "expect": 1200
   }
  ],
  "score": [
   {
    "args": [
     "0.025"
    ],
    "expect": 2
   },
   {
