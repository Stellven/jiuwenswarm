    ],
    "expect": "+100.0"
   },
   {
    "args": [
     -100.04
    ],
    "expect": "-100.0"
   }
  ]
 },
 {
  "id": "collapse_adjacent",
  "function": "collapse_adjacent",
  "trap": "only ADJACENT equal items collapse; equal items that are apart are all kept",
  "spec": "collapse_adjacent(items) takes a list and returns a new list in which every run of consecutive equal items (compared with ==) is replaced by a single copy of that item. Equal items that are not next to each other are NOT removed. Order is kept. An empty list gives an empty list.",
  "examples": [
   "collapse_adjacent([3, 3]) == [3]",
   "collapse_adjacent(['p', 'q']) == ['p', 'q']"
  ],
  "gate": [
   {
    "args": [
