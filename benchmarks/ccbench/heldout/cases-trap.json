    ],
    "expect": [
     0,
     1,
     2
    ]
   },
   {
    "args": [
     [
      1
     ],
     [
      0,
      1
     ]
    ],
    "expect": [
     1
    ]
   },
   {
    "args": [
     [
      12.0001,
      2.9999
     ],
     [
      3,
      6,
      9,
      12
     ]
    ],
    "expect": [
     0,
     0,
     0
    ]
   },
   {
    "args": [
     [
      5.999,
      6,
      6.001
     ],
     [
      3,
      6,
      9,
      12
     ]
    ],
    "expect": [
     1,
     2,
     0
    ]
   }
  ]
 },
 {
  "id": "competition_rank",
  "function": "competition_rank",
  "trap": "tied scores share the lowest rank number and the next rank skips ahead (1, 2, 2, 4)",
  "spec": "competition_rank(scores) returns the rank of every score, in input order, as a list of ints. The highest score has rank 1. The rank of a score is 1 plus the number of scores in the list that are strictly greater than it. So equal scores get the same rank, and the rank after a tie skips ahead. An empty list gives an empty list.",
  "examples": [
   "competition_rank([10, 30, 20]) == [3, 1, 2]",
   "competition_rank([4]) == [1]"
  ],
  "gate": [
   {
    "args": [
     [
      10,
      20,
      30
     ]
    ],
    "expect": [
     3,
     2,
     1
    ]
   },
   {
    "args": [
     [
      5,
      5,
      3
     ]
    ],
    "expect": [
     1,
     1,
     3
    ]
   },
   {
    "args": [
     []
    ],
    "expect": []
   },
   {
    "args": [
     [
      7
     ]
    ],
    "expect": [
     1
    ]
   }
  ],
  "score": [
   {
    "args": [
     [
      3,
      5,
      5,
      5,
      1
     ]
    ],
    "expect": [
     4,
     1,
     1,
     1,
     5
    ]
   },
   {
    "args": [
     [
      1,
      1,
      1
     ]
    ],
    "expect": [
     1,
     1,
     1
    ]
   },
   {
    "args": [
     [
      9,
      8,
      8,
      7,
      7,
      7,
      1
     ]
    ],
    "expect": [
     1,
     2,
     2,
     4,
     4,
     4,
     7
    ]
   },
   {
    "args": [
     [
      2,
      2,
      1,
      1
     ]
    ],
    "expect": [
     1,
     1,
     3,
     3
    ]
   },
   {
    "args": [
     [
      -1,
      -1,
      0
     ]
    ],
    "expect": [
     2,
     2,
     1
    ]
   },
   {
    "args": [
     [
      1.5,
      1.5,
      2
     ]
    ],
    "expect": [
     2,
     2,
     1
    ]
   },
   {
    "args": [
     [
      4,
      3,
      3,
      2
     ]
    ],
    "expect": [
     1,
     2,
     2,
     4
    ]
   }
  ]
 },
 {
  "id": "consistent_groups",
  "function": "consistent_groups",
  "trap": "an empty list is NOT consistent (all([]) would say True) and zero breaks the sign",
  "spec": "consistent_groups(groups) takes a dict that maps a name to a list of numbers and returns the sorted list of names whose list is consistent. A list is consistent when it is not empty and either every number in it is strictly greater than 0 or every number in it is strictly less than 0. Zero is neither positive nor negative, so a list that contains a zero is not consistent. An empty list is not consistent. An empty dict gives an empty list.",
  "examples": [
   "consistent_groups({'a': [4, 9]}) == ['a']",
   "consistent_groups({'a': [3, -3]}) == []"
  ],
  "gate": [
   {
    "args": [
     {
      "a": [
       1,
       2
      ],
      "b": []
     }
    ],
    "expect": [
     "a"
    ]
   },
   {
    "args": [
     {
      "p": [
       -1
      ],
      "q": [
       1,
       -1
      ]
     }
    ],
    "expect": [
     "p"
    ]
   },
   {
    "args": [
     {
      "m": [
       3,
       4
      ],
      "n": [
       -3,
       -4
      ]
     }
    ],
    "expect": [
     "m",
     "n"
    ]
   },
   {
    "args": [
     {}
    ],
    "expect": []
   }
  ],
  "score": [
   {
    "args": [
     {
      "x": [],
      "y": [
       -1
      ],
      "z": [
       0
      ]
     }
    ],
    "expect": [
     "y"
    ]
   },
   {
    "args": [
     {
      "a": [],
      "b": []
     }
    ],
    "expect": []
   },
   {
    "args": [
