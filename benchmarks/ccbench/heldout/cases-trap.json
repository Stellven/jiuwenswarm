[
 {
  "id": "parse_size",
  "function": "parse_size",
  "trap": "separator between number and unit is optional (zero or more spaces)",
  "spec": "parse_size(s) converts a size string to a number of bytes (int). The string is a non-negative integer written with digits 0-9, then zero or more space characters, then one unit: B, KB, MB or GB (uppercase only). Leading and trailing spaces are allowed. 1 KB is 1024 B, 1 MB is 1024 KB, 1 GB is 1024 MB. Raise ValueError for anything else: an empty string, a number with no unit, a unit with no number, an unknown unit, a lowercase unit, a sign, or a fractional number.",
  "examples": [
   "parse_size('3 B') == 3",
   "parse_size('2 KB') == 2048"
  ],
  "gate": [
   {
    "args": [
     "1KB"
    ],
    "expect": 1024
   },
   {
    "args": [
     "2 MB"
    ],
    "expect": 2097152
   },
   {
    "args": [
     "5B"
    ],
    "expect": 5
   },
   {
    "args": [
     "12"
    ],
    "raises": "ValueError"
   }
  ],
  "score": [
   {
    "args": [
     "3GB"
    ],
    "expect": 3221225472
   },
   {
    "args": [
     "10  KB"
    ],
    "expect": 10240
   },
   {
    "args": [
     " 7MB "
    ],
    "expect": 7340032
   },
   {
    "args": [
     "0B"
    ],
    "expect": 0
   },
   {
    "args": [
     "1kb"
    ],
    "raises": "ValueError"
   },
   {
    "args": [
     "1.5KB"
    ],
    "raises": "ValueError"
   },
   {
    "args": [
     ""
    ],
    "raises": "ValueError"
   },
   {
    "args": [
     "4 TB"
    ],
    "raises": "ValueError"
   },
   {
    "args": [
     "KB"
    ],
    "raises": "ValueError"
   },
   {
    "args": [
     "-1KB"
    ],
    "raises": "ValueError"
   }
  ]
 },
 {
  "id": "bucket_counts",
  "function": "bucket_counts",
  "trap": "the last bin includes its upper edge; all other bins exclude theirs",
  "spec": "bucket_counts(values, edges) counts numbers into bins. edges is a strictly increasing list of at least 2 numbers e0 < e1 < ... < en. There are n bins. Bin i covers e_i <= v < e_(i+1) (lower edge included, upper edge excluded), except the LAST bin, which also includes its upper edge: e_(n-1) <= v <= e_n. A value below e0 or above e_n is ignored. Return a list of n integer counts, one per bin, in order.",
  "examples": [
   "bucket_counts([1], [0, 5, 10]) == [1, 0]",
   "bucket_counts([7, 8], [0, 5, 10]) == [0, 2]"
  ],
  "gate": [
   {
    "args": [
     [
      1,
      2,
      3
     ],
     [
      0,
      2,
      4
     ]
    ],
    "expect": [
     1,
     2
    ]
   },
   {
    "args": [
     [
      4
     ],
     [
      0,
      2,
      4
     ]
    ],
    "expect": [
     0,
     1
    ]
   },
   {
    "args": [
     [],
     [
      0,
      1
     ]
    ],
    "expect": [
     0
    ]
   },
   {
    "args": [
     [
      -1,
      5
     ],
     [
      0,
      2,
      4
     ]
    ],
    "expect": [
     0,
     0
    ]
   }
  ],
  "score": [
   {
    "args": [
     [
      0,
      5,
      10
     ],
     [
      0,
      5,
      10
     ]
    ],
    "expect": [
     1,
     2
    ]
   },
   {
    "args": [
     [
      10,
      10,
      9.5
     ],
     [
      0,
      5,
      10
     ]
    ],
    "expect": [
     0,
     3
    ]
   },
   {
    "args": [
     [
      3,
      3,
      3
     ],
     [
      3,
      6,
      9,
      12
     ]
    ],
    "expect": [
     3,
     0,
     0
    ]
   },
   {
    "args": [
     [
      6,
