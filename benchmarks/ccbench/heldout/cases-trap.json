     "-0.135"
    ],
    "expect": -14
   },
   {
    "args": [
     "2.675"
    ],
    "expect": 268
   },
   {
    "args": [
     "0.004"
    ],
    "expect": 0
   },
   {
    "args": [
     "-0.004"
    ],
    "expect": 0
   },
   {
    "args": [
     "0.0051"
    ],
    "expect": 1
   },
   {
    "args": [
     "100.995"
    ],
    "expect": 10100
   }
  ]
 },
 {
  "id": "format_delta",
  "function": "format_delta",
  "trap": "a value that formats as zero (including -0.0 and -0.04) is \"0.0\" with no sign",
  "spec": "format_delta(x) takes a float and returns a string for display. Format x with one digit after the decimal point exactly as Python's '%.1f' % x does. If the formatted number is not zero, a positive number is written with a leading '+' and a negative number keeps its '-'. If the formatted number is zero (this includes '-0.0', which arises from -0.0 and from small negative values such as -0.04), return '0.0' with no sign at all.",
  "examples": [
   "format_delta(2.25) == '+2.2'",
   "format_delta(-7.5) == '-7.5'"
  ],
  "gate": [
   {
    "args": [
     1.5
    ],
    "expect": "+1.5"
   },
   {
    "args": [
     -2.0
    ],
    "expect": "-2.0"
   },
   {
    "args": [
     0.0
    ],
    "expect": "0.0"
   },
   {
    "args": [
     -0.04
    ],
    "expect": "0.0"
   }
  ],
  "score": [
   {
    "args": [
     -0.0
    ],
    "expect": "0.0"
   },
   {
    "args": [
     0.04
    ],
    "expect": "0.0"
   },
   {
    "args": [
     0.06
    ],
    "expect": "+0.1"
   },
   {
    "args": [
     -0.06
    ],
    "expect": "-0.1"
   },
   {
