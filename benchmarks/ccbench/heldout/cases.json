    "expect": 1
   },
   {
    "args": [
     "3.4",
     "3.4.0.0.1"
    ],
    "expect": -1
   }
  ]
 },
 {
  "id": "round_half_up",
  "function": "round_half_up",
  "spec": "round_half_up(value, ndigits) takes a decimal number written as a string (for example '-2.345') and an integer ndigits >= 0. It rounds to ndigits places with ties rounded away from zero (2.5 -> 3, -2.5 -> -3) and works on the exact decimal value, not on a binary float. It returns a string with exactly ndigits digits after the decimal point, and no decimal point when ndigits is 0. A result that is zero is never written with a minus sign.",
  "examples": [
   "round_half_up('1.234', 2) == '1.23'",
   "round_half_up('0.5', 0) == '1'"
  ],
  "gate": [
   {
    "args": [
     "2.5",
     0
    ],
    "expect": "3"
   },
   {
    "args": [
     "2.345",
     2
    ],
    "expect": "2.35"
   },
   {
    "args": [
     "-2.5",
     0
    ],
    "expect": "-3"
   },
   {
    "args": [
     "1",
     2
    ],
    "expect": "1.00"
   }
  ],
  "score": [
   {
