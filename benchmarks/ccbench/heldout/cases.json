 {
  "id": "parse_duration",
  "function": "parse_duration",
  "spec": "parse_duration(s) converts a duration string to total seconds (int). The string has one or more terms, each a non-negative integer followed by one unit letter: d (86400 s), h (3600 s), m (60 s), s (1 s). Terms may appear in any order and may be separated by spaces; leading and trailing spaces are allowed. Each unit may appear at most once. Raise ValueError for anything else: an empty string, a number with no unit, an unknown unit, a repeated unit, a sign, or a fractional number.",
  "examples": [
   "parse_duration('2m') == 120",
   "parse_duration('1h 1s') == 3601"
  ],
  "gate": [
   {
    "args": [
     "1h30m"
    ],
    "expect": 5400
   },
   {
    "args": [
     "90s"
    ],
    "expect": 90
   },
   {
    "args": [
     "2d"
    ],
    "expect": 172800
   },
   {
    "args": [
     ""
    ],
    "raises": "ValueError"
   }
  ],
  "score": [
   {
    "args": [
     "1d 1h 1m 1s"
    ],
    "expect": 90061
   },
   {
    "args": [
     "30m1h"
    ],
