 {
  "id": "compare_versions",
  "function": "compare_versions",
  "spec": "compare_versions(a, b) compares two dotted version strings made of non-negative integer parts, such as '1.2.10'. Parts are compared as integers from left to right. A missing trailing part counts as 0, so '1.0' equals '1.0.0'. Leading zeros do not matter. Return -1 if a < b, 0 if equal, 1 if a > b.",
  "examples": [
   "compare_versions('1.2', '1.3') == -1",
   "compare_versions('2.0', '2.0') == 0"
  ],
  "gate": [
   {
    "args": [
     "1.2.3",
     "1.2.4"
    ],
    "expect": -1
   },
   {
    "args": [
     "1.0",
     "1.0.0"
    ],
    "expect": 0
   },
   {
    "args": [
     "1.10",
     "1.9"
    ],
    "expect": 1
   },
   {
    "args": [
     "2",
     "1.9.9"
    ],
    "expect": 1
   }
  ],
  "score": [
   {
