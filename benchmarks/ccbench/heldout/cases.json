     "2.675",
     2
    ],
    "expect": "2.68"
   }
  ]
 },
 {
  "id": "rle_decode",
  "function": "rle_decode",
  "spec": "rle_decode(s) decodes a run-length string. The input has lowercase letters a-z and decimal digits. A letter may be preceded by a decimal count of any length (the full run of digits right before it); the letter is then repeated that many times. A letter with no count is repeated once. A count of 0 produces nothing for that letter. The count applies only to the single letter after it. Return the decoded string. The input never ends with digits.",
  "examples": [
   "rle_decode('2a') == 'aa'",
   "rle_decode('b2c') == 'bcc'"
  ],
  "gate": [
   {
    "args": [
     "3a2b"
    ],
    "expect": "aaabb"
   },
   {
    "args": [
     "abc"
    ],
    "expect": "abc"
   },
   {
    "args": [
     "12x"
    ],
    "expect": "xxxxxxxxxxxx"
   },
   {
    "args": [
     "a3b"
    ],
    "expect": "abbb"
   }
  ],
  "score": [
   {
    "args": [
     ""
    ],
    "expect": ""
   },
   {
    "args": [
     "10a1b"
    ],
    "expect": "aaaaaaaaaab"
   },
   {
    "args": [
     "0a2b"
    ],
    "expect": "bb"
   },
   {
    "args": [
     "2ab"
    ],
    "expect": "aab"
   },
   {
    "args": [
     "1a1b1c"
    ],
    "expect": "abc"
   },
   {
    "args": [
     "11z"
    ],
    "expect": "zzzzzzzzzzz"
   },
   {
    "args": [
     "z2y"
    ],
    "expect": "zyy"
   }
  ]
 },
 {
  "id": "business_days",
  "function": "business_days",
  "spec": "business_days(start, end, holidays) counts business days in the half-open range [start, end): start is included, end is excluded. start and end are ISO dates 'YYYY-MM-DD'. A business day is Monday to Friday and not in holidays (a list of ISO date strings, possibly with duplicates, possibly on weekends or outside the range). If end <= start the result is 0. Return an int.",
  "examples": [
   "business_days('2024-01-01', '2024-01-02', []) == 1  # 2024-01-01 is a Monday",
   "business_days('2024-01-05', '2024-01-08', []) == 1"
  ],
