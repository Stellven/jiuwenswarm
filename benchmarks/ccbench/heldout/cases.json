 {
  "id": "wrap_text",
  "function": "wrap_text",
  "spec": "wrap_text(text, width) splits text into lines by greedy word wrapping. Words are separated by any whitespace; collapse all whitespace so words in a line are joined by a single space and no line has leading or trailing spaces. Put as many words on a line as fit within width characters. A word longer than width goes on a line of its own and is not broken. Return a list of lines. Empty or all-whitespace text gives an empty list.",
  "examples": [
   "wrap_text('aa bb cc', 5) == ['aa bb', 'cc']",
   "wrap_text('abcdefgh', 3) == ['abcdefgh']"
  ],
  "gate": [
