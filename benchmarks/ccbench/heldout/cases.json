 {
  "id": "merge_intervals",
  "function": "merge_intervals",
  "spec": "merge_intervals(intervals) takes a list of [start, end] integer pairs (start <= end) in any order and returns the merged list sorted by start. Intervals that overlap or merely touch (one ends exactly where the next starts) are merged into one. Return a list of [start, end] lists. An empty input gives an empty list.",
  "examples": [
   "merge_intervals([[1, 4], [6, 8]]) == [[1, 4], [6, 8]]",
   "merge_intervals([[1, 5], [2, 3]]) == [[1, 5]]"
  ],
