  "mujoco": "3.17.0"
 },
 "references": [
  "arXiv 2603.14634, analytic free-fall test",
  "MuJoCo engine tests (free joint integration)"
 ],
 "model_assumptions": "a free sphere with no contact (contype 0) under uniform gravity; displacement of the body origin from t = 0 to the declared time.",
 "budgets": {
  "wall_time_s": 600,
  "physical_memory_mb": 1024,
  "gpu_required": false,
  "max_model_calls": 0
 },
 "inputs": [
