   }
  }
 },
 "measurements": [
  {
   "measurement_id": "period",
   "scope": "trial",
   "unit": "s",
   "required": true,
   "definition": {
    "kind": "period",
    "signal": "qpos:hinge",
    "direction": "up"
   }
  }
 ],
 "observations": [
  {
   "signal": "qpos:hinge",
   "unit": "rad",
   "rate_hz": 2500
  }
 ]
}
