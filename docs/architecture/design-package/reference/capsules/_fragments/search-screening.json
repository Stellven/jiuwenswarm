    },
    {
      "path": "candidate_set_invalid_uncited_idea.json",
      "field_contract_id": "candidate-set:field-contract:2",
      "schema_id": null,
      "expect": "invalid",
      "rejected_by": "idea_citations_resolve"
    },
    {
      "path": "screening_rubric.json",
      "field_contract_id": "screening-rubric:field-contract:1",
      "schema_id": null,
      "expect": "valid"
    },
    {
      "path": "screening_result.json",
      "field_contract_id": "screening-result:field-contract:2",
      "schema_id": null,
      "expect": "valid"
    },
    {
      "path": "screening_result_invalid_score_out_of_range.json",
      "field_contract_id": "screening-result:field-contract:2",
      "schema_id": null,
      "expect": "invalid",
      "rejected_by": "score_range"
    },
    {
      "path": "opportunity_card.json",
      "field_contract_id": "opportunity-card:field-contract:2",
      "schema_id": null,
      "expect": "valid"
    },
    {
      "path": "opportunity_card_invalid_unlisted_idea.json",
      "field_contract_id": "opportunity-card:field-contract:2",
      "schema_id": null,
      "expect": "invalid",
      "rejected_by": "selected_in_candidates"
    },
    {
      "path": "search_capsule.json",
      "field_contract_id": null,
      "schema_id": "urn:jiuwenswarm:m1-design:capsule-declaration:1.0.0",
      "expect": "valid"
    },
    {
      "path": "screening_capsule.json",
      "field_contract_id": null,
      "schema_id": "urn:jiuwenswarm:m1-design:capsule-declaration:1.0.0",
      "expect": "valid"
    }
  ],
  "replaces": [
    "candidate-set:field-contract:1",
    "screening-result:field-contract:1",
    "opportunity-card:field-contract:1"
  ],
  "contract_index_rows": [
    "| search-scope | 1.0.0 | [Fields](capsules/search.md#search_scope-field-contract) | Planner binding -> Search CC, checking |",
    "| candidate-set | 2.0.0 | [Fields](capsules/search.md#candidate_set) | Search CC -> Screening CC, checking |",
    "| screening-rubric | 1.0.0 | [Fields](capsules/screening.md#screening_rubric-field-contract) | CC owner pin -> Screening CC, checking, RSI referee |",
    "| screening-result | 2.0.0 | [Fields](capsules/screening.md#screening_result) | Screening CC -> Hypothesis CC, checking, RSI |",
    "| opportunity-card | 2.0.0 | [Fields](capsules/screening.md#opportunity_card) | Screening CC -> Hypothesis CC, checking |"
  ],
  "remove_from_shared_pages": [
    "field-catalog.md sections candidate-set, screening-result, opportunity-card (replace with links to the capsule pages)",
    "other-contracts.md rows 21, 22 and 23 (candidate_set, screening assessments, opportunity_card)",
    "contract-index.md rows for candidate-set, screening-result and opportunity-card at version 1.0.0",
    "field-contracts.json types Citation, Idea, IdeaScore and Ranking (replaced by the types in this fragment)"
  ],
  "prd_conflicts": [
