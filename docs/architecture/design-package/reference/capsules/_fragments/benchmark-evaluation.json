  "types": {
    "BenchmarkMetric": {
      "fields": {
        "metric_id": {
          "type": "string",
          "required": true,
          "meaning": "Equals a blueprint metric_id"
        },
        "unit": {
          "type": "string",
          "required": true,
          "meaning": "Equals the blueprint unit"
        },
        "aggregation": {
          "type": "string",
          "required": true,
          "meaning": "How repeats combine into value. Equals the blueprint aggregation",
          "enum": [
            "min",
            "max",
            "mean",
            "median"
          ]
        },
        "baseline": {
          "type": "MetricSide",
          "required": true,
          "meaning": "Baseline measurements"
        },
        "treatment": {
          "type": "MetricSide",
          "required": true,
          "meaning": "Treatment measurements"
        },
        "delta": {
          "type": "nullable-number",
          "required": true,
          "meaning": "Treatment minus baseline value. Non-null exactly when both values are non-null"
        }
      }
    },
    "MetricSide": {
      "fields": {
        "repeats": {
          "type": "number[]",
          "required": true,
          "meaning": "Raw value of each completed repeat in order. Length equals repeat_count when value is non-null",
          "min_items": 0
        },
        "value": {
          "type": "nullable-number",
          "required": true,
          "meaning": "Registered aggregate of repeats. Null exactly when unmeasured_reason is non-null"
        },
        "unmeasured_reason": {
          "type": "nullable-string",
          "required": true,
          "meaning": "Why no value exists. Null or one of the enum values",
          "enum": [
            "run_failed",
            "timeout",
            "metric_not_emitted",
            "non_finite_value",
            "resource_limit_exceeded"
          ]
        }
      }
    },
    "RunRecord": {
      "fields": {
        "sequence": {
          "type": "integer",
          "required": true,
          "meaning": "Global execution position, unique",
          "min": 1
        },
        "role": {
          "type": "string",
          "required": true,
          "meaning": "Which subject ran",
          "enum": [
            "baseline",
            "treatment"
          ]
        },
        "repeat_index": {
          "type": "integer",
          "required": true,
          "meaning": "Repeat number within the role, below repeat_count",
          "min": 0
        },
        "seed": {
          "type": "integer",
          "required": true,
          "meaning": "Equals blueprint seed for every run (fixed_same_for_all_runs)"
        },
        "subject_ref": {
          "type": "Ref",
          "required": true,
          "meaning": "Baseline: blueprint baseline_identity.resource_ref. Treatment: manifest archive_ref"
        },
        "command": {
          "type": "string[]",
          "required": true,
          "meaning": "Command line as executed",
          "min_items": 1
        },
        "exit_code": {
          "type": "integer",
          "required": true,
          "meaning": "Process exit code"
        },
        "started_at": {
          "type": "string",
          "required": true,
          "meaning": "UTC ISO 8601 start time"
        },
        "wall_time_s": {
          "type": "number",
          "required": true,
          "meaning": "Elapsed seconds",
          "min": 0
        },
        "timeout_s": {
          "type": "number",
          "required": true,
          "meaning": "Time limit applied, greater than 0"
        },
        "stdout_ref": {
          "type": "Ref",
          "required": true,
          "meaning": "Captured standard output"
        },
        "stderr_ref": {
          "type": "Ref",
          "required": true,
          "meaning": "Captured standard error"
        },
        "hardware_ref": {
          "type": "string",
          "required": true,
          "meaning": "Equals hardware_inventory.hardware_id"
        }
      }
    },
    "HardwareInventory": {
      "fields": {
        "hardware_id": {
          "type": "string",
          "required": true,
          "meaning": "Identity runs refer to"
        },
        "gpu_model": {
          "type": "nullable-string",
          "required": true,
          "meaning": "GPU name. Non-null when gpu_count above 0"
        },
        "gpu_count": {
          "type": "integer",
          "required": true,
          "meaning": "GPUs visible to the runs",
          "min": 0
        },
        "gpu_memory_mb": {
          "type": "nullable-integer",
          "required": true,
          "meaning": "Memory per GPU. Non-null when gpu_count above 0"
        },
        "driver_version": {
          "type": "nullable-string",
          "required": true,
          "meaning": "GPU driver"
        },
        "cuda_version": {
          "type": "nullable-string",
          "required": true,
          "meaning": "CUDA or equivalent runtime"
        },
        "cpu_model": {
          "type": "string",
          "required": true,
          "meaning": "CPU name"
        },
        "cpu_cores": {
          "type": "integer",
          "required": true,
          "meaning": "Logical cores",
          "min": 1
        },
        "ram_mb": {
          "type": "integer",
          "required": true,
          "meaning": "System memory",
          "min": 1
        },
        "os": {
          "type": "string",
          "required": true,
          "meaning": "Operating system and kernel"
        },
        "captured_at": {
          "type": "string",
          "required": true,
          "meaning": "UTC ISO 8601, before the first started_at"
        }
      }
    },
    "InstalledPackage": {
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "meaning": "Package name"
        },
        "locked_version": {
          "type": "string",
          "required": true,
          "meaning": "Exact version from the lock"
        },
        "installed_version": {
          "type": "string",
          "required": true,
          "meaning": "Must equal locked_version"
        },
        "hash_verified": {
          "type": "boolean",
          "required": true,
          "meaning": "Must be true when the lock carries a hash"
        }
      }
    },
    "ProvisioningEffect": {
      "fields": {
        "op": {
          "type": "string",
          "required": true,
          "meaning": "Change made",
          "enum": [
            "unpack_bundle",
            "create_venv",
            "install_package"
          ]
        },
        "target": {
          "type": "string",
          "required": true,
          "meaning": "Path under /workspace/poc/"
        },
        "outcome": {
          "type": "string",
          "required": true,
          "meaning": "Result",
          "enum": [
            "ok",
            "failed"
          ]
        }
      }
    },
    "MetricVerdictFinding": {
      "fields": {
        "metric_id": {
          "type": "string",
          "required": true,
          "meaning": "Equals a blueprint metric_id, unique across findings"
        },
        "classification": {
          "type": "string",
          "required": true,
          "meaning": "Result for this metric",
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "CONDITIONALLY_ACCEPTABLE"
          ]
        },
        "rule_applied": {
          "type": "string",
          "required": true,
          "meaning": "Registered rule that decided it",
          "enum": [
            "success",
            "falsification",
            "conditional",
            "middle",
            "unmeasured"
          ]
        },
        "rule_text": {
          "type": "string",
          "required": true,
          "meaning": "Registered rule in words",
          "min": 1,
          "max": 300
        },
        "baseline_value": {
          "type": "nullable-number",
          "required": true,
          "meaning": "Equals payload baseline value"
        },
        "treatment_value": {
          "type": "nullable-number",
          "required": true,
          "meaning": "Equals payload treatment value"
        },
        "threshold": {
          "type": "nullable-number",
          "required": true,
          "meaning": "Non-null exactly when rule_applied is success, falsification or conditional"
        },
        "rationale": {
          "type": "string",
          "required": true,
          "meaning": "Names values, threshold and outcome",
          "min": 1,
          "max": 600
        }
      }
    },
    "CompletenessReview": {
      "fields": {
        "status": {
          "type": "string",
          "required": true,
          "meaning": "incomplete exactly when a metric side is unmeasured",
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "notes": {
          "type": "string[]",
          "required": true,
          "meaning": "Notes, each under 300 characters"
        }
      }
    },
    "PlausibilityReview": {
      "fields": {
        "status": {
          "type": "string",
          "required": true,
          "meaning": "implausible flags an execution anomaly",
          "enum": [
            "plausible",
            "implausible",
            "not_assessable"
          ]
        },
        "notes": {
          "type": "string[]",
          "required": true,
          "meaning": "Notes. At least one when status is not plausible"
        }
      }
    }
  },
