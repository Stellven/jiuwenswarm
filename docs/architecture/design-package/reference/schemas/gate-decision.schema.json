{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:m1-design:gate-decision:2.0.0",
  "title": "Protected gate decision",
  "description": "Only authorized host code may author and commit this record. Schema validity alone never grants release authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "invocation_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    },
    "policy_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "check_plan_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    },
    "output_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    },
    "deterministic_result_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "assessment_ref": {
      "anyOf": [
        {
          "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_KNOWN_LIMITATIONS",
        "FAIL",
        "ENVIRONMENT_BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Reason"
      },
      "minItems": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "advance",
        "halt"
      ]
    },
    "accepted_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      },
      "additionalProperties": true,
      "description": "Namespaced diagnostic data; does not modify required meaning, permissions or acceptance."
    },
    "scope_kind": {
      "enum": [
        "node",
        "subnode"
      ]
    },
    "subnode_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "node_contract_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "internal_decision_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "recorded_at",
    "run_id",
    "node_id",
    "attempt_id",
    "contract_ref",
    "invocation_refs",
    "policy_ref",
    "check_plan_ref",
    "input_refs",
    "output_refs",
    "deterministic_result_ref",
    "assessment_ref",
    "verdict",
    "reasons",
    "action",
    "accepted_refs",
    "scope_kind",
    "subnode_id",
    "node_contract_ref",
    "internal_decision_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "advance"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "PASS_WITH_KNOWN_LIMITATIONS"
            ]
          },
          "assessment_ref": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "accepted_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          },
          "invocation_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          },
          "output_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "FAIL",
              "ENVIRONMENT_BLOCKED",
              "INCONCLUSIVE"
            ]
          },
          "accepted_refs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope_kind": {
            "const": "subnode"
          }
        }
      },
      "then": {
        "properties": {
          "subnode_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "subnode_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
