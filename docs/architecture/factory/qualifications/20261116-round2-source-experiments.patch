From: Factory source workbench <factory@localhost>
Date: Mon, 16 Nov 2026 15:24:23 -0500
Subject: [PATCH 1/3] Bound ARM64 caller completion spin before sleeping

---
 src/dsv41/ds4_pool.hpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/dsv41/ds4_pool.hpp b/src/dsv41/ds4_pool.hpp
index f2d0975b..fcd8d2c7 100644
--- a/src/dsv41/ds4_pool.hpp
+++ b/src/dsv41/ds4_pool.hpp
@@ -80,7 +80,20 @@ public:
     }
     void wait() {
         if (n_ <= 0) return;
+#if defined(__aarch64__)
+        // Keep short completions cheap, then release CPU quota to active workers.
+        const auto spin_end = std::chrono::steady_clock::now() + std::chrono::microseconds(200);
+        while (done_.load(std::memory_order_acquire) < n_) {
+            if (std::chrono::steady_clock::now() >= spin_end) {
+                std::unique_lock<std::mutex> lk(completion_mu_);
+                completion_cv_.wait(lk, [&] { return done_.load(std::memory_order_acquire) >= n_; });
+                break;
+            }
+            cpu_relax();
+        }
+#else
         while (done_.load(std::memory_order_acquire) < n_) cpu_relax();
+#endif
         n_ = 0;
     }
 
@@ -93,7 +106,15 @@ private:
             if ((int) (t & 0xffffffffu) >= n) return;
             if (!ticket_.compare_exchange_weak(t, t + 1, std::memory_order_acq_rel)) continue;
             (*fn_)((int) (t & 0xffffffffu));
+#if defined(__aarch64__)
+            if (done_.fetch_add(1, std::memory_order_acq_rel) + 1 == n) {
+                // Pair with the waiter's predicate check so a completion cannot lose its wake.
+                std::lock_guard<std::mutex> lk(completion_mu_);
+                completion_cv_.notify_one();
+            }
+#else
             done_.fetch_add(1, std::memory_order_acq_rel);
+#endif
         }
     }
     void loop() {
@@ -130,6 +151,10 @@ private:
     std::atomic<bool> quit_{false};
     std::mutex mu_;
     std::condition_variable cv_;
+#if defined(__aarch64__)
+    std::mutex completion_mu_;
+    std::condition_variable completion_cv_;
+#endif
 };
 
 /// File reads on threads of their own, in the order they were pushed, the pusher never waiting: the prompt path's
