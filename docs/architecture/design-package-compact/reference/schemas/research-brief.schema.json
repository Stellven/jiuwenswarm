{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:m1-design:research-brief:2.0.0",
  "title": "Research Brief: accepted downstream research contract",
  "description": "Whole Intention Compiler node output. User meaning, program obligations and attributed defaults; no experimental protocol or release authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "intent_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "objective": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/RequirementStatement"
    },
    "in_scope": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/RequirementStatement"
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/RequirementStatement"
      },
      "minItems": 0
    },
    "mandatory_requirements": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/RequirementStatement"
      },
      "minItems": 1
    },
    "optional_preferences": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/RequirementStatement"
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "system_default",
              "derived"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          },
          "scope": {
            "enum": [
              "compiler",
              "research_run",
              "scientific_execution"
            ]
          },
          "normalized_value": {
            "anyOf": [
              {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "operator": {
            "enum": [
              "lt",
              "le",
              "eq",
              "ge",
              "gt",
              "qualitative"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "category",
          "origin",
          "source_refs",
          "scope",
          "normalized_value",
          "unit",
          "operator"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "lt",
                    "le",
                    "ge",
                    "gt"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "normalized_value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "qualitative"
                }
              }
            },
            "then": {
              "properties": {
                "normalized_value": {
                  "type": "null"
                },
                "unit": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "eq"
                }
              }
            },
            "then": {
              "properties": {
                "normalized_value": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "target_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "target_text": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          },
          "origin": {
            "enum": [
              "user",
              "system_default",
              "derived"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "comparison": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "comparator": {
                    "enum": [
                      "lt",
                      "le",
                      "eq",
                      "ge",
                      "gt"
                    ]
                  },
                  "reference": {
                    "enum": [
                      "baseline",
                      "constant"
                    ]
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "comparator",
                  "reference",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "metric",
          "target_text",
          "source_refs",
          "origin",
          "requirement_ids",
          "unit",
          "comparison"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "artifact_type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "acceptance_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirement_ids",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirement_ids",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "authority_ref": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "affected_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "text",
          "authority_ref",
          "affected_fields"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Uncertainty"
      },
      "minItems": 0
    },
    "resource_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "user_request",
            "authorized_assumptions"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "minItems": 1
        }
      },
      "required": [
        "basis",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      },
      "additionalProperties": true,
      "description": "Namespaced diagnostic data; does not modify required meaning, permissions or acceptance."
    },
    "intake_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 0
    },
    "domain_lane": {
      "const": "scientific_research"
    },
    "input_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "reference_document",
              "project_asset",
              "validation_data"
            ]
          },
          "resource_ref": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          }
        },
        "required": [
          "id",
          "role",
          "resource_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "intent_ref",
    "objective",
    "in_scope",
    "out_of_scope",
    "mandatory_requirements",
    "optional_preferences",
    "constraints",
    "target_metrics",
    "deliverables",
    "acceptance_expectations",
    "evidence_obligations",
    "assumptions",
    "unresolved_items",
    "resource_refs",
    "confirmation",
    "intake_ref",
    "context_refs",
    "domain_lane",
    "input_bindings"
  ],
  "additionalProperties": false
}
