{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:source-text",
  "title": "source_text",
  "x-source": "types/source-text.md",
  "x-version": "1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source_kind": {
      "enum": [
        "prompt",
        "document",
        "resource"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "offset_basis": {
      "enum": [
        "unicode_codepoint"
      ]
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "text",
    "source_ref",
    "source_kind",
    "content_sha256",
    "offset_basis"
  ]
}
