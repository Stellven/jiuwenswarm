{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:opportunity-card",
  "title": "opportunity_card",
  "x-source": "types/opportunity-card.md",
  "x-version": "2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idea_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "problem_statement": {
          "type": "string",
          "pattern": "\\S"
        },
        "mechanism": {
          "type": "string",
          "pattern": "\\S"
        },
        "opportunity_statement": {
          "type": "string",
          "pattern": "\\S"
        },
        "relevance": {
          "type": "string",
          "pattern": "\\S"
        },
        "linked_citations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "linked_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "core_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "evidence_maturity": {
          "type": "string",
          "pattern": "\\S"
        },
        "verification_path": {
          "type": "string",
          "pattern": "\\S"
        },
        "strategic_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user_value": {
              "type": "string",
              "pattern": "\\S"
            },
            "timing": {
              "type": "string",
              "pattern": "\\S"
            },
            "safety": {
              "type": "string",
              "pattern": "\\S"
            },
            "legal_license": {
              "type": "string",
              "pattern": "\\S"
            },
            "resources": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "user_value",
            "timing",
            "safety",
            "legal_license",
            "resources"
          ]
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "identified_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "idea_ids",
        "title",
        "summary",
        "problem_statement",
        "mechanism",
        "opportunity_statement",
        "relevance",
        "linked_citations",
        "linked_chunk_ids",
        "core_assumptions",
        "evidence_maturity",
        "verification_path",
        "strategic_context",
        "uncertainties",
        "identified_risks",
        "open_questions"
      ]
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idea_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1
          },
          "novelty": {
            "type": "integer"
          },
          "feasibility": {
            "type": "integer"
          },
          "compute_alignment": {
            "type": "integer"
          },
          "justifications": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "composite": {
            "type": "integer"
          },
          "rank": {
            "type": "integer"
          },
          "eligible": {
            "type": "boolean"
          },
          "dependency_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "package",
                    "model",
                    "dataset"
                  ]
                },
                "identifier": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "compatible",
                    "conflict",
                    "unknown"
                  ]
                },
                "registry_entry_ref": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "evidence_type",
                        "reference"
                      ],
                      "properties": {
                        "evidence_type": {
                          "type": "string"
                        },
                        "reference": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "metadata": {
                          "type": "object"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "registry_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "identifier",
                "status",
                "registry_entry_ref",
                "reason",
                "registry_sha256"
              ]
            }
          },
          "rationale": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "idea_ids",
          "novelty",
          "feasibility",
          "compute_alignment",
          "justifications",
          "composite",
          "rank",
          "eligible",
          "dependency_assessments",
          "rationale"
        ]
      },
      "minItems": 1
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "card",
    "scores"
  ]
}
