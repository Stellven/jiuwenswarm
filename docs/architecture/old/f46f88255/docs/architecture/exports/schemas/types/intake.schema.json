{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:intake",
  "title": "intake",
  "x-source": "types/intake.md",
  "x-version": "2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prompt": {
      "type": "string",
      "pattern": "\\S"
    },
    "channel": {
      "enum": [
        "cli",
        "web"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "reference_document",
              "project_asset",
              "validation_data"
            ]
          },
          "source": {
            "enum": [
              "supplied",
              "preinstalled"
            ]
          },
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "resource_id",
          "kind",
          "source",
          "path",
          "label"
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "path": {
            "type": "string"
          },
          "format": {
            "enum": [
              "txt",
              "md",
              "pdf"
            ]
          },
          "size_bytes": {
            "type": "integer"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "document_id",
          "path",
          "format",
          "size_bytes",
          "text"
        ]
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "unsupported_format",
              "too_large",
              "unreadable",
              "empty_text"
            ]
          }
        },
        "required": [
          "path",
          "reason"
        ]
      }
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "prompt",
    "channel",
    "resources",
    "documents",
    "skipped"
  ]
}
