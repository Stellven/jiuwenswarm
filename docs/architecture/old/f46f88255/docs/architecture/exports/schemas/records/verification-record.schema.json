{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:records:verification-record",
  "title": "verification-record",
  "x-source": "schemas/verification-record.md",
  "x-version": "cc.verification.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "library": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "at": {
      "type": "string"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ]
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "visibility": {
      "enum": [
        "all",
        "builder_hidden"
      ]
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    },
    "invocation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "source": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "runner_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_type": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "evidence_type",
                "reference"
              ]
            }
          },
          "judge": {
            "type": "object"
          }
        },
        "required": [
          "check_id",
          "source",
          "result",
          "runner_sha256"
        ]
      }
    },
    "decision": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "gate_verdict": {
          "enum": [
            "PASS",
            "PASS_WITH_KNOWN_LIMITATIONS",
            "FAIL",
            "ENVIRONMENT_BLOCKED",
            "INCONCLUSIVE"
          ]
        },
        "normalized_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "INCONCLUSIVE"
          ]
        },
        "routing_action": {
          "enum": [
            "ADVANCE",
            "HALT",
            "ESCALATE_TO_HUMAN"
          ]
        },
        "tier_1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            }
          },
          "required": [
            "status",
            "checks"
          ]
        },
        "tier_2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_RUN"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "evidence_type": {
                          "type": "string"
                        },
                        "reference": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "metadata": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "evidence_type",
                        "reference"
                      ]
                    }
                  }
                },
                "required": [
                  "code",
                  "message"
                ]
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "evidence_type": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "evidence_type",
                  "reference"
                ]
              }
            }
          },
          "required": [
            "status",
            "reasons",
            "evidence_refs"
          ]
        },
        "failed_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_type": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "evidence_type",
              "reference"
            ]
          }
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "stage_id",
        "gate_verdict",
        "normalized_verdict",
        "routing_action",
        "tier_1",
        "tier_2",
        "failed_checks",
        "warnings",
        "known_limitations",
        "evidence_refs",
        "timestamp"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "scope",
    "at",
    "producer",
    "invocation_ref",
    "results",
    "decision",
    "gate_result"
  ]
}
