{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:evaluation-verdict",
  "title": "evaluation_verdict",
  "x-source": "types/evaluation-verdict.md",
  "x-version": "2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "CONDITIONALLY_ACCEPTABLE"
      ]
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "measured": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim_met": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "acceptance_met": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "falsified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "enum": [
              "met",
              "between",
              "falsified",
              "unmeasured"
            ]
          }
        },
        "required": [
          "metric_id",
          "measured",
          "claim_met",
          "acceptance_met",
          "falsified",
          "outcome"
        ]
      },
      "minItems": 1
    },
    "evidence_complete": {
      "type": "boolean"
    },
    "plausibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plausible": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "plausible",
        "rationale"
      ]
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "classification",
    "comparisons",
    "evidence_complete",
    "plausibility",
    "residual_risks",
    "follow_ups"
  ]
}
