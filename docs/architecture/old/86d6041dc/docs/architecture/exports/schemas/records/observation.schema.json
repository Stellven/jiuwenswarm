{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:records:observation",
  "title": "observation",
  "x-source": "schemas/observation.md",
  "x-version": "cc.observation.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "library": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "at": {
      "type": "string"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ]
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "visibility": {
      "enum": [
        "all",
        "builder_hidden"
      ]
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    },
    "caller": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "binding_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "test_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decl_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "x-note": "item fields are described in the page's prose, not tabulated"
      }
    },
    "outcome": {
      "enum": [
        "ok",
        "error",
        "refused"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "seen_code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "x-note": "item fields are described in the page's prose, not tabulated"
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "object"
        },
        "time_s": {
          "type": "number"
        },
        "money": {
          "type": "number"
        }
      },
      "required": [
        "time_s"
      ]
    },
    "trajectory_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "effects_observed": {
      "type": "array",
      "items": {
        "type": "object",
        "x-note": "item fields are described in the page's prose, not tabulated"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "scope",
    "at",
    "producer",
    "caller",
    "started_at",
    "binding_ref",
    "decl_hash",
    "attempt",
    "inputs",
    "outputs",
    "predicates",
    "outcome",
    "reason",
    "cost",
    "effects_observed"
  ]
}
