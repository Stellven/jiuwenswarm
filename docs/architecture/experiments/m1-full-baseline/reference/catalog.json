        "Phase 3"
      ]
    },
    {
      "topic": "shared clients and model access",
      "document": "other-contracts.md#client-and-model-boundaries",
      "version": "1.0.0",
      "applicable_phases": [
        "Phase 1",
        "Phase 2",
        "Phase 3"
      ]
    },
    {
