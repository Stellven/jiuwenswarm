{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:hypothesis-blueprint",
  "title": "hypothesis_blueprint",
  "x-source": "types/hypothesis-blueprint.md",
  "x-version": "2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "type": "string",
      "pattern": "\\S"
    },
    "middle_zone_classification": {
      "enum": [
        "INCONCLUSIVE",
        "CONDITIONALLY_ACCEPTABLE"
      ]
    },
    "independent_variable": {
      "type": "string",
      "pattern": "\\S"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "brief_metric_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "goal",
              "guard"
            ]
          },
          "raw_unit": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "absolute",
              "delta",
              "relative_percent",
              "percentage_points"
            ]
          },
          "better": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "expected": {
            "type": "number"
          },
          "expected_comparator": {
            "enum": [
              "lt",
              "lte",
              "gt",
              "gte",
              "eq"
            ]
          },
          "falsified_at": {
            "type": "number"
          },
          "falsification_comparator": {
            "enum": [
              "lt",
              "lte",
              "gt",
              "gte",
              "eq"
            ]
          },
          "acceptance_target": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "acceptance_comparator": {
            "anyOf": [
              {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "eq"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "method_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "method_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "statistic": {
            "enum": [
              "mean",
              "median",
              "minimum",
              "maximum"
            ]
          }
        },
        "required": [
          "metric_id",
          "brief_metric_id",
          "name",
          "role",
          "raw_unit",
          "unit",
          "basis",
          "better",
          "expected",
          "expected_comparator",
          "falsified_at",
          "falsification_comparator",
          "acceptance_target",
          "acceptance_comparator",
          "method_id",
          "method_sha256",
          "statistic"
        ]
      },
      "minItems": 1
    },
    "baseline_resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "dataset_resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "resource_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "benchmark_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repeats": {
      "type": "integer"
    },
    "seed": {
      "type": "integer"
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "required": [
        "description",
        "file",
        "line"
      ]
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "claim",
    "middle_zone_classification",
    "independent_variable",
    "metrics",
    "baseline_resource_id",
    "dataset_resource_id",
    "resource_snapshot_sha256",
    "benchmark_config_sha256",
    "repeats",
    "seed",
    "mechanism",
    "verification_plan"
  ]
}
