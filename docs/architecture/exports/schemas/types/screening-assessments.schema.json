{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:screening-assessments",
  "title": "screening_assessments",
  "x-source": "types/screening-assessments.md",
  "x-version": "2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idea_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "pattern": "\\S"
          },
          "problem_statement": {
            "type": "string",
            "pattern": "\\S"
          },
          "mechanism": {
            "type": "string",
            "pattern": "\\S"
          },
          "opportunity_statement": {
            "type": "string",
            "pattern": "\\S"
          },
          "relevance": {
            "type": "string",
            "pattern": "\\S"
          },
          "linked_citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1
          },
          "linked_chunk_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1
          },
          "core_assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "evidence_maturity": {
            "type": "string",
            "pattern": "\\S"
          },
          "verification_path": {
            "type": "string",
            "pattern": "\\S"
          },
          "strategic_context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user_value": {
                "type": "string",
                "pattern": "\\S"
              },
              "timing": {
                "type": "string",
                "pattern": "\\S"
              },
              "safety": {
                "type": "string",
                "pattern": "\\S"
              },
              "legal_license": {
                "type": "string",
                "pattern": "\\S"
              },
              "resources": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "user_value",
              "timing",
              "safety",
              "legal_license",
              "resources"
            ]
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "identified_risks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "package",
                    "model",
                    "dataset"
                  ]
                },
                "identifier": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "identifier",
                "evidence"
              ]
            }
          },
          "novelty": {
            "type": "integer"
          },
          "feasibility": {
            "type": "integer"
          },
          "compute_alignment": {
            "type": "integer"
          },
          "justifications": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "idea_ids",
          "title",
          "summary",
          "problem_statement",
          "mechanism",
          "opportunity_statement",
          "relevance",
          "linked_citations",
          "linked_chunk_ids",
          "core_assumptions",
          "evidence_maturity",
          "verification_path",
          "strategic_context",
          "uncertainties",
          "identified_risks",
          "open_questions",
          "dependencies",
          "novelty",
          "feasibility",
          "compute_alignment",
          "justifications"
        ]
      },
      "minItems": 1
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "candidates"
  ]
}
