{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:benchmark-payload",
  "title": "benchmark_payload",
  "x-source": "types/benchmark-payload.md",
  "x-version": "2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seed": {
      "type": "integer"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "arm": {
            "enum": [
              "baseline",
              "treatment"
            ]
          },
          "repeat_index": {
            "type": "integer"
          },
          "seed": {
            "type": "integer"
          },
          "exit_status": {
            "type": "integer"
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "measurement_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "arm",
          "repeat_index",
          "seed",
          "exit_status",
          "stdout_sha256",
          "stderr_sha256",
          "measurement_ref",
          "values"
        ]
      },
      "minItems": 1
    },
    "deltas": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "unmeasured": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "seed",
    "runs",
    "deltas",
    "unmeasured"
  ]
}
