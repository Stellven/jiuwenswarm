{
  "schema_version": "sequential-cases:1",
  "policy": "stop",
  "limits": {
    "deadline_s": 7800,
    "poll_s": 2,
    "command_timeout_s": 30,
    "command_cpu_s": 30,
    "command_memory_mb": 512,
    "max_total_bytes": 134217728,
    "max_artifact_bytes": 67108864
  },
  "cases": [
    {
      "id": "case1-cpu",
      "task": "Using only the attached data, test whether logistic regression beats a 1-nearest-neighbour baseline by at least 5 points accuracy. Train on train.csv, write predictions for test.csv to predictions.csv, and report your conclusion and limitations.",
      "inputs": [
        {
          "path": "demos-20261023/case1-cpu/test.csv",
          "destination": "test.csv",
          "kind": "datasets"
        },
        {
          "path": "demos-20261023/case1-cpu/train.csv",
          "destination": "train.csv",
          "kind": "datasets"
        },
        {
          "path": "demos-20261023/case1-cpu/data-description.md",
          "destination": "data-description.md",
          "kind": "docs"
        },
        {
          "path": "case1-full-20261023-01/provenance.py",
          "destination": "provenance.py",
          "upload": false
        },
        {
          "path": "case1-full-20261023-01/runtime-meta.json",
          "destination": "runtime-meta.json",
          "upload": false
        }
      ],
      "setup": [
        {
          "id": "capture-runtime",
          "trusted": true,
          "command": [
            "python",
            "inputs/provenance.py"
          ],
          "outputs": [
            "runtime-environment.json"
          ],
          "timeout_s": 20
        }
      ],
      "repeats": 1
    }
  ]
}
