{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:m1-design:common:1.0.0",
  "title": "Shared contract definitions",
  "type": "null",
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "CodePin": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Span": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source_ref",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "Statement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Span"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "text",
        "source_spans"
      ],
      "additionalProperties": false
    },
    "RequirementStatement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "user",
            "system_default",
            "derived"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Uncertainty": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing",
            "ambiguous",
            "conflicting"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "affected_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "clarification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "affected_fields",
        "blocking",
        "clarification"
      ],
      "additionalProperties": false
    },
    "Reason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "criterion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "message",
        "criterion_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "name",
        "artifact_type",
        "schema_ref",
        "required",
        "description",
        "check_ids"
      ],
      "additionalProperties": false
    },
    "Effect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "resource_key": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "idempotent": {
          "type": "boolean"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "none",
            "scoped",
            "inverse",
            "compensate",
            "emission"
          ]
        },
        "undo": {
          "anyOf": [
            {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/CodePin"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "type": "object",
          "properties": {
            "severity": {
              "type": "string",
              "minLength": 1
            },
            "blast_radius": {
              "type": "string",
              "minLength": 1
            },
            "irreversibility": {
              "type": "boolean"
            }
          },
          "required": [
            "severity",
            "blast_radius",
            "irreversibility"
          ],
          "additionalProperties": false
        },
        "assurance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "resource_key",
        "op",
        "scope",
        "idempotent",
        "reversibility",
        "undo",
        "risk",
        "assurance"
      ],
      "additionalProperties": false
    }
  }
}
