{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:m1-design:subnode-execution-contract:1.0.0",
  "title": "Protected Subnode Execution Contract: exactly one CC",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "declaration_ref": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "implementation_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          },
          "dependency_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 0
          },
          "admission_ref": {
            "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
          },
          "effective_authority": {
            "type": "object",
            "properties": {
              "network": {
                "enum": [
                  "none",
                  "allowlist"
                ]
              },
              "network_allowlist": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "resource_reads": {
                "type": "array",
                "items": {
                  "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
                },
                "minItems": 0
              },
              "write_roots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "network",
              "network_allowlist",
              "resource_reads",
              "write_roots",
              "tools"
            ],
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "properties": {
              "time_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "model_calls": {
                "type": "integer",
                "minimum": 0
              },
              "memory_mb": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "time_s",
              "model_calls",
              "memory_mb"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "role",
          "declaration_ref",
          "implementation_refs",
          "dependency_refs",
          "admission_ref",
          "effective_authority",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "contract_id",
          "version",
          "required",
          "artifact_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "contract_id",
          "version",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
      },
      "minItems": 1
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "guard_profile_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "policy_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "configuration_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "template_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "subnode_id": {
      "type": "string",
      "minLength": 1
    },
    "node_contract_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "subnode_limits": {
      "type": "object",
      "properties": {
        "time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "time_s",
        "model_calls",
        "memory_mb"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "run_id",
    "node_id",
    "attempt_id",
    "revision",
    "objective",
    "requirement_ids",
    "bindings",
    "inputs",
    "outputs",
    "input_refs",
    "required_outputs",
    "evidence_obligations",
    "subnode_limits",
    "guard_profile_ref",
    "policy_ref",
    "configuration_ref",
    "template_ref",
    "subnode_id",
    "node_contract_ref"
  ],
  "additionalProperties": false,
  "description": "A CC execution within a governed node. Parent contract, admission and policy all constrain authority."
}
