{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:m1-design:deterministic-check-result:1.0.0",
  "title": "Deterministic check result",
  "description": "Protected mechanical checking on an exact subject; a pass permits semantic assessment, not release.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subject_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "check_plan_ref": {
      "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "ENVIRONMENT_BLOCKED",
              "INCONCLUSIVE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:jiuwenswarm:m1-design:common:1.0.0#/$defs/Ref"
            },
            "minItems": 0
          }
        },
        "required": [
          "check_id",
          "outcome",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      },
      "additionalProperties": true,
      "description": "Namespaced diagnostic data; does not modify required meaning, permissions or acceptance."
    }
  },
  "required": [
    "schema_version",
    "subject_ref",
    "check_plan_ref",
    "results"
  ],
  "additionalProperties": false
}
