{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:records:finding",
  "title": "finding",
  "x-source": "schemas/finding.md",
  "x-version": "cc.finding.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "library": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "at": {
      "type": "string"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ]
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "visibility": {
      "enum": [
        "all",
        "builder_hidden"
      ]
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    },
    "kind": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "x-note": "item fields are described in the page's prose, not tabulated"
      }
    },
    "step_id": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_type": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "evidence_type",
          "reference"
        ]
      }
    },
    "measure": {
      "type": "object"
    },
    "detail": {}
  },
  "required": [
    "schema_version",
    "id",
    "scope",
    "at",
    "producer",
    "kind",
    "subjects",
    "text",
    "evidence"
  ]
}
