{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:search-hits",
  "title": "search_hits",
  "x-source": "types/search-hits.md",
  "x-version": "1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "local",
              "arxiv",
              "semantic_scholar"
            ]
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1
          }
        },
        "required": [
          "source_id",
          "kind",
          "title",
          "authors",
          "locator",
          "chunks"
        ]
      }
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "hits"
  ]
}
