{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:evidence-bundle",
  "title": "evidence_bundle",
  "x-source": "types/evidence-bundle.md",
  "x-version": "1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capsule_name": {
          "type": "string"
        },
        "decl_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "capsule_name",
        "decl_hash",
        "summary"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          },
          "rubric": {
            "type": "string",
            "pattern": "\\S"
          },
          "over": {
            "enum": [
              "outputs",
              "inputs_and_outputs"
            ]
          }
        },
        "required": [
          "check_id",
          "description",
          "rubric",
          "over"
        ]
      },
      "minItems": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {}
    },
    "issues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_type",
                  "reference"
                ],
                "properties": {
                  "evidence_type": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "subject",
    "criteria",
    "inputs",
    "outputs",
    "issues"
  ]
}
