{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cc:types:verifier-assessment",
  "title": "verifier_assessment",
  "x-source": "types/verifier-assessment.md",
  "x-version": "1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "rationale": {
            "type": "string",
            "pattern": "\\S"
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "check_id",
          "result",
          "rationale",
          "quotes"
        ]
      },
      "minItems": 1
    },
    "ext": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "criteria"
  ]
}
