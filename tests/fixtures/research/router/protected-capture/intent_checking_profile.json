  "criteria": [
    {
      "criterion_id": "declared_output_conformance",
      "question": "Does the output contain what the declaration says this CC produces, in the declared shape and ports?",
      "blocking": true,
      "answerable_from": "declaration_and_output",
      "target_port": null
    },
    {
      "criterion_id": "internal_consistency",
      "question": "Does the output avoid contradicting itself, for example a field that disagrees with another field in the same output?",
      "blocking": true,
      "answerable_from": "declaration_and_output",
      "target_port": null
    },
    {
      "criterion_id": "limitations_consistency",
      "question": "Are the limitations and uncertainties the output states consistent with the output content and with the declaration's stated limits?",
      "blocking": true,
      "answerable_from": "declaration_and_output",
      "target_port": null
    },
    {
      "criterion_id": "uncertainty_consistency",
      "question": "Does `readiness.status` agree with the listed uncertainties (`ready` only when none is blocking)?",
      "blocking": true,
      "answerable_from": "declaration_and_output",
      "target_port": "intent"
    }
  ],
