+void llama_context::expert_prefetch_advise(size_t il, int32_t id) {
+#ifdef __linux__
+    auto & state = expert_prefetch_layers[il];
+    for (auto it = state.recent.begin(); it != state.recent.end();) {
+        if (state.tokens - it->second >= 32) {
+            it = state.recent.erase(it);
+        } else {
+            if (it->first == id) {
+                const auto hit = *it;
+                state.recent.erase(it);
+                state.recent.push_back(hit);
+                return;
+            }
+            ++it;
+        }
+    }
+    const auto & layer = model.layers[il];
+    bool advised = false;
+    bool failed = false;
+    for (const ggml_tensor * w : { layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps }) {
+        if (!w) {
+            continue;
+        }
+        if (id < 0 || id >= w->ne[2] || w->ne[3] != 1 || !ggml_is_contiguous(w) ||
+                w->nb[2] == 0 || !model.tensor_is_mapped(w)) {
+            if (!expert_prefetch_warned) {
+                LLAMA_LOG_INFO("expert_prefetch: skipping non-mmap or non-expert-contiguous tensors/invalid ids (once)\n");
+                expert_prefetch_warned = true;
+            }
+            continue;
+        }
+        static const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+        const uintptr_t start = reinterpret_cast<uintptr_t>(w->data) + size_t(id) * w->nb[2];
+        if (page == 0 || page == UINTPTR_MAX || start > UINTPTR_MAX - w->nb[2] ||
+                start + w->nb[2] > UINTPTR_MAX - (page - 1)) {
+            continue;
+        }
+        const uintptr_t first = start - start % page;
+        const uintptr_t end = start + w->nb[2];
+        const uintptr_t last = end + (page - end % page) % page;
+        ++expert_prefetch_calls;
+        expert_prefetch_bytes += last - first;
+        if (madvise(reinterpret_cast<void *>(first), last - first, MADV_WILLNEED) != 0) {
+            ++expert_prefetch_failures;
+            failed = true;
+        } else {
+            advised = true;
+        }
+    }
+    if (advised && !failed) {
+        if (state.recent.size() == 32) {
+            state.recent.erase(state.recent.begin());
+        }
+        state.recent.emplace_back(id, state.tokens);
+    }
+#else
+    (void) il;
+    (void) id;
+#endif
+}
+
+void llama_context::expert_prefetch_cb(ggml_tensor * t, bool ask, bool * observe, void * data) {
+    auto & ctx = *static_cast<llama_context *>(data);
+    if (t->op != GGML_OP_MUL_MAT_ID || !t->src[0] || !t->src[2]) {
+        return;
+    }
+    size_t il = 0;
+    for (; il < ctx.model.layers.size(); ++il) {
+        const auto & layer = ctx.model.layers[il];
+        if (t->src[0] == layer.ffn_up_exps || t->src[0] == layer.ffn_gate_exps ||
+                t->src[0] == layer.ffn_down_exps || t->src[0] == layer.ffn_gate_up_exps) {
+            break;
+        }
+    }
+    if (il == ctx.model.layers.size() || ctx.expert_prefetch_layers[il].observed) {
+        return;
+    }
+    *observe = true;
+    if (ask) {
+        return;
+    }
+    auto & state = ctx.expert_prefetch_layers[il];
+    state.observed = true;
+    const ggml_tensor * ids = t->src[2];
+    const ggml_tensor * base = ids->view_src ? ids->view_src : ids;
+    if (ids->type != GGML_TYPE_I32 || ids->ne[2] != 1 || ids->ne[3] != 1 ||
+            !ids->data || !base->buffer || !ggml_backend_buffer_is_host(base->buffer) ||
+            !strstr(ids->name, "ffn_moe_topk-")) {
+        if (!ctx.expert_prefetch_warned) {
+            LLAMA_LOG_INFO("expert_prefetch: skipping unsupported router ids (once)\n");
+            ctx.expert_prefetch_warned = true;
+        }
+        return;
+    }
+    std::vector<int32_t> selected;
+    for (int64_t token = 0; token < ids->ne[1]; ++token) {
+        for (int64_t k = 0; k < ids->ne[0]; ++k) {
+            int32_t id;
+            memcpy(&id, static_cast<const char *>(ids->data) + token * ids->nb[1] + k * ids->nb[0], sizeof(id));
+            if (id >= 0 && id < t->src[0]->ne[2] &&
+                    std::find(selected.begin(), selected.end(), id) == selected.end()) {
+                selected.push_back(id);
+            }
+        }
+    }
+    state.tokens += ids->ne[1];
+    for (int32_t id : state.predicted) {
+        ++ctx.expert_prefetch_total;
+        ctx.expert_prefetch_hits += std::find(selected.begin(), selected.end(), id) != selected.end();
+    }
+    state.predicted.clear();
+    for (int32_t id : selected) {
+        ctx.expert_prefetch_advise(il, id);
+    }
+    if (ctx.expert_prefetch_next && il + 1 < ctx.model.layers.size()) {
+        auto & next = ctx.expert_prefetch_layers[il + 1];
+        const ggml_tensor * w = ctx.model.layers[il + 1].ffn_down_exps;
+        if (w && !next.observed) {
+            for (int32_t id : selected) {
+                if (id < w->ne[2]) {
+                    next.predicted.push_back(id);
+                    ctx.expert_prefetch_advise(il + 1, id);
+                }
+            }
+        }
+    }
+}
