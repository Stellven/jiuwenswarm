+bool llama_model::expert_file_info(const ggml_tensor * t, expert_file_range & out, bool require_host) const {
+    if (!t || (require_host && !tensor_is_mapped(t))) { return false; }
+    const auto it = pimpl->expert_offsets.find(t->name);
+    if (it == pimpl->expert_offsets.end()) { return false; }
+    const auto idx = it->second.first;
+    const auto offset = it->second.second;
+    if (idx >= pimpl->mappings.size() || idx >= pimpl->expert_files.size()) { return false; }
+    const auto & mapping = pimpl->mappings[idx];
+    if (offset > mapping->size() || ggml_nbytes(t) > mapping->size() - offset ||
+            (require_host && static_cast<char *>(mapping->addr()) + offset != t->data)) { return false; }
+    out = {idx, offset, mapping->size(), mapping->addr(), pimpl->expert_files[idx]->file_id()};
