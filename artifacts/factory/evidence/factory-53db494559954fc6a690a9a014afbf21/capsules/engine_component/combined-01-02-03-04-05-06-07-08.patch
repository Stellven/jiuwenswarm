+void llama_context::expert_pregate_stats() {
+    uint64_t bytes=0, reads=0, errors=0, dropped=0, cancelled_jobs=0, cancelled_bytes=0, demand_ns=0;
+    for (auto & entry : expert_fillers) {
+        entry.second->wait_async(); // teardown only, after graph synchronize
+        demand_ns += entry.second->counters().total_fill_wall_ns;
+        const auto c = entry.second->async_counters();
+        bytes += c.bytes_read; reads += c.read_syscalls; errors += c.errors; dropped += c.dropped;
+        cancelled_jobs += c.cancelled_jobs; cancelled_bytes += c.cancelled_bytes;
+    }
+    const auto & t = pregate_timeliness;
+    LLAMA_LOG_INFO("expert_pregate: stats predictions=%" PRIu64 " arrivals=%" PRIu64
+        " hits=%" PRIu64 " actual=%" PRIu64 " predicted=%" PRIu64 " recall_at_k=%.6f precision=%.6f"
+        " async_bytes_read=%" PRIu64 " async_reads=%" PRIu64 " async_errors=%" PRIu64 " dropped=%" PRIu64
+        " cancelled_jobs=%" PRIu64 " cancelled_bytes=%" PRIu64
+        " inflight_at_arrival=%" PRIu64 " inflight_reads=%" PRIu64 " pending_reads=%" PRIu64
+        " sync_bytes_with_prediction=%" PRIu64 " sync_bytes_without_prediction=%" PRIu64
+        " sync_calls_with_prediction=%" PRIu64 " sync_calls_without_prediction=%" PRIu64 " skips=%" PRIu64
+        " pred_done=%" PRIu64 " pred_inflight=%" PRIu64 " pred_queued=%" PRIu64 " pred_resident_at_predict=%" PRIu64
+        " hit_done=%" PRIu64 " hit_inflight=%" PRIu64 " hit_queued=%" PRIu64 " hit_resident=%" PRIu64
+        " recall_at_k_d1=%.6f recall_at_k_d2=%.6f actual_d1=%" PRIu64 " actual_d2=%" PRIu64
+        " hits_d1=%" PRIu64 " hits_d2=%" PRIu64
+        " demand_wait_ns_total=%" PRIu64 " demand_wait_ns_per_token=%.3f\n",
+        pregate_predictions, pregate_arrivals, pregate_hits, pregate_actual, pregate_predicted,
+        pregate_actual ? double(pregate_hits)/pregate_actual : 0.0,
+        pregate_predicted ? double(pregate_hits)/pregate_predicted : 0.0,
+        bytes, reads, errors, dropped, cancelled_jobs, cancelled_bytes, pregate_inflight_arrivals, pregate_inflight_reads, pregate_pending_reads,
+        pregate_sync_with, pregate_sync_without, pregate_calls_with, pregate_calls_without, pregate_skips,
+        t.pred_done, t.pred_inflight, t.pred_queued, t.pred_resident_at_predict,
+        t.hit_done, t.hit_inflight, t.hit_queued, t.hit_resident,
+        pregate_actual_d[0] ? double(pregate_hits_d[0])/pregate_actual_d[0] : 0.0,
+        pregate_actual_d[1] ? double(pregate_hits_d[1])/pregate_actual_d[1] : 0.0,
+        pregate_actual_d[0], pregate_actual_d[1], pregate_hits_d[0], pregate_hits_d[1],
+        demand_ns, expert_demand_tokens ? double(demand_ns)/expert_demand_tokens : 0.0);
+}
