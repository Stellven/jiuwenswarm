+#ifdef __linux__
+void llama_context::expert_fill_init() {
+    if (expert_fill_checked) { return; }
+    expert_fill_checked = true;
+    if (!expert_config.fill) { return; }
+    try {
+        for (const auto & layer : model.layers) {
+            for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
+                if (!w) { continue; }
+                llama_model::expert_file_range info;
+                if (w->ne[2] <= 0 || w->ne[3] != 1 || !ggml_is_contiguous(w) || !w->nb[2] ||
+                        !model.expert_file_info(w, info)) {
+                    throw std::runtime_error("expert tensors not mmap-backed or file offsets unavailable/unsupported layout");
+                }
+                if (!expert_fillers.count(info.file_index)) {
+                    expert_fillers.emplace(info.file_index, std::make_unique<ExpertFiller>(
+                        "/proc/self/fd/" + std::to_string(info.source_fd), info.mapping, info.mapping_size, expert_config));
+                }
+            }
+        }
+        if (expert_fillers.empty()) { throw std::runtime_error("no mmap-backed expert tensors"); }
+        expert_prefetch_layers.resize(model.layers.size());
+        expert_fill_enabled = true;
+        expert_pregate_init();
+        expert_diag_enabled = expert_fillers.begin()->second->diagnostic();
+        if (expert_diag_enabled) {
+            if (!expert_config.diag_csv.empty()) {
+                expert_diag_csv = fopen(expert_config.diag_csv.c_str(), "w");
+                if (!expert_diag_csv) { throw std::runtime_error("cannot open diagnostic CSV"); }
+                fprintf(expert_diag_csv, "token_idx,fill_ns,between_ns,majflt_fill,majflt_between,post_fill_nonresident_pages,pre_use_nonresident_pages,bytes_read\n");
+            }
+        }
+        expert_fill_random_decode = expert_config.random == "decode";
+        expert_fill_min_tokens = expert_config.min_tokens;
+        expert_fill_max_tokens = expert_config.max_tokens;
+        const auto & filler = *expert_fillers.begin()->second;
+        LLAMA_LOG_INFO("expert_fill: active threads=%zu chunk_kib=%zu random=%s files=%zu\n",
+            filler.threads(), filler.chunk_bytes() / 1024, expert_config.random.c_str(), expert_fillers.size());
+    } catch (const std::exception & e) {
+        expert_fill_enabled = false; expert_diag_enabled = false;
+        if (expert_diag_csv) { fclose(expert_diag_csv); expert_diag_csv = nullptr; }
+        expert_fillers.clear();
+        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
+    }
+}
+
+// Qwen35MoE (the Qwen3.6 GGUF uses this arch):
+// x_L = RMSNorm(attention_L + residual_L, attn_post_norm_L, eps).
+// logits = W*x, p = softmax(logits), ids = topk(p); no gate_inp_b,
+// no exp_probs_b, no groups. Selected weights are normalized AFTER top-k.
+// softmax is monotone, so ranking logits gives the same IDs (ties by ID).
+void llama_context::expert_pregate_init() {
+    if (!expert_config.pregate) { return; }
+    try {
+        if (model.arch != LLM_ARCH_QWEN35MOE || model.hparams.n_expert_groups > 1 || !loras->empty() || !model.hdmd.rot.empty()) {
+            throw std::runtime_error("pregate requires qwen35moe without groups, LoRA, or folded rotations");
+        }
+        expert_pregate_before = expert_config.order == "before";
+        expert_pregate_k = expert_config.k;
+        expert_pregate_layers.resize(model.hparams.n_layer()); // excludes unexecuted MTP blocks
+        const long page = sysconf(_SC_PAGESIZE);
+        if (page <= 0) { throw std::runtime_error("invalid page size"); }
+        // Decode/copy from file once, never GPU tensor data. Original mmap may have holes.
+        for (size_t il = 1; il < expert_pregate_layers.size(); ++il) {
+            const auto * w = model.layers[il].ffn_gate_inp;
+            llama_model::expert_file_range info;
+            if (!w || !ggml_is_contiguous(w) || w->ne[0] != model.hparams.n_embd ||
+                    w->ne[1] != model.hparams.n_expert || w->ne[2] != 1 || w->ne[3] != 1 ||
+                    !model.expert_file_info(w, info, false)) {
+                throw std::runtime_error("router file offsets/layout unavailable");
+            }
+            const auto * traits = ggml_get_type_traits(w->type);
+            if (w->type != GGML_TYPE_F32 && !traits->to_float) {
+                throw std::runtime_error("router type has no CPU decoder");
+            }
+            auto & dst = expert_pregate_layers[il].router;
+            dst.resize(ggml_nelements(w));
+            const size_t first = info.offset / size_t(page) * size_t(page);
+            const size_t delta = info.offset - first, len = delta + ggml_nbytes(w);
+            void * ptr = mmap(nullptr, len, PROT_READ, MAP_PRIVATE, info.source_fd, off_t(first));
+            if (ptr == MAP_FAILED) { throw std::runtime_error("router file mmap failed"); }
+            const char * data = static_cast<const char *>(ptr) + delta;
+            if (w->type == GGML_TYPE_F32) { memcpy(dst.data(), data, ggml_nbytes(w)); }
+            else {
+                for (int64_t row = 0; row < w->ne[1]; ++row) {
+                    traits->to_float(data + row * w->nb[1], dst.data() + row * w->ne[0], w->ne[0]);
+                }
+            }
+            munmap(ptr, len);
+        }
+        expert_pregate_enabled = true;
+        LLAMA_LOG_INFO("expert_pregate: active k=%zu arch=qwen35moe gating=softmax router=file-cpu-copy order=%s\n",
+            expert_pregate_k, expert_pregate_before ? "before" : "after");
+    } catch (const std::exception & e) {
+        expert_pregate_layers.clear();
+        LLAMA_LOG_INFO("expert_pregate: inactive (%s)\n", e.what());
+    }
+}
